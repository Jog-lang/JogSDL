// Raw SDL3 atomic — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.
import std.c

@link("SDL3")
extern {
    fn SDL_TryLockSpinlock(lock: *void): bool
    fn SDL_LockSpinlock(lock: *void)
    fn SDL_UnlockSpinlock(lock: *void)
    fn SDL_MemoryBarrierReleaseFunction()
    fn SDL_MemoryBarrierAcquireFunction()
    fn SDL_CompareAndSwapAtomicInt(a: *void, oldval: c.int, newval: c.int): bool
    fn SDL_SetAtomicInt(a: *void, v: c.int): c.int
    fn SDL_GetAtomicInt(a: *void): c.int
    fn SDL_AddAtomicInt(a: *void, v: c.int): c.int
    fn SDL_CompareAndSwapAtomicU32(a: *void, oldval: u32, newval: u32): bool
    fn SDL_SetAtomicU32(a: *void, v: u32): u32
    fn SDL_GetAtomicU32(a: *void): u32
    fn SDL_AddAtomicU32(a: *void, v: c.int): u32
    fn SDL_CompareAndSwapAtomicPointer(a: **void, oldval: *void, newval: *void): bool
    fn SDL_SetAtomicPointer(a: **void, v: *void): *void
    fn SDL_GetAtomicPointer(a: **void): *void
}
