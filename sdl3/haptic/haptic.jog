// Raw SDL3 haptic — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.
import std.c
import sdl3.joystick

@opaque struct SDL_Haptic

@link("SDL3")
extern {
    fn SDL_GetHaptics(count: *c.int): *u32
    fn SDL_GetHapticNameForID(instance_id: u32): *const c.char
    fn SDL_OpenHaptic(instance_id: u32): *SDL_Haptic
    fn SDL_GetHapticFromID(instance_id: u32): *SDL_Haptic
    fn SDL_GetHapticID(haptic: *SDL_Haptic): u32
    fn SDL_GetHapticName(haptic: *SDL_Haptic): *const c.char
    fn SDL_IsMouseHaptic(): bool
    fn SDL_OpenHapticFromMouse(): *SDL_Haptic
    fn SDL_IsJoystickHaptic(joystick: *joystick.SDL_Joystick): bool
    fn SDL_OpenHapticFromJoystick(joystick: *joystick.SDL_Joystick): *SDL_Haptic
    fn SDL_CloseHaptic(haptic: *SDL_Haptic)
    fn SDL_GetMaxHapticEffects(haptic: *SDL_Haptic): c.int
    fn SDL_GetMaxHapticEffectsPlaying(haptic: *SDL_Haptic): c.int
    fn SDL_GetHapticFeatures(haptic: *SDL_Haptic): u32
    fn SDL_GetNumHapticAxes(haptic: *SDL_Haptic): c.int
    fn SDL_HapticEffectSupported(haptic: *SDL_Haptic, effect: *const void): bool
    fn SDL_SetHapticGain(haptic: *SDL_Haptic, gain: c.int): bool
    fn SDL_SetHapticAutocenter(haptic: *SDL_Haptic, autocenter: c.int): bool
    fn SDL_PauseHaptic(haptic: *SDL_Haptic): bool
    fn SDL_ResumeHaptic(haptic: *SDL_Haptic): bool
    fn SDL_StopHapticEffects(haptic: *SDL_Haptic): bool
    fn SDL_HapticRumbleSupported(haptic: *SDL_Haptic): bool
    fn SDL_InitHapticRumble(haptic: *SDL_Haptic): bool
    fn SDL_PlayHapticRumble(haptic: *SDL_Haptic, strength: f32, length: u32): bool
    fn SDL_StopHapticRumble(haptic: *SDL_Haptic): bool
}
