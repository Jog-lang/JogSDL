// SDL_scancode.h — physical key codes (enum). Full set is large; bind common + demo set.
val SDL_SCANCODE_UNKNOWN: u32 = 0
val SDL_SCANCODE_A: u32 = 4
val SDL_SCANCODE_B: u32 = 5
val SDL_SCANCODE_C: u32 = 6
val SDL_SCANCODE_D: u32 = 7
val SDL_SCANCODE_E: u32 = 8
val SDL_SCANCODE_Q: u32 = 20
val SDL_SCANCODE_S: u32 = 22
val SDL_SCANCODE_W: u32 = 26
val SDL_SCANCODE_ESCAPE: u32 = 41
val SDL_SCANCODE_SPACE: u32 = 44
val SDL_SCANCODE_RIGHT: u32 = 79
val SDL_SCANCODE_LEFT: u32 = 80
val SDL_SCANCODE_DOWN: u32 = 81
val SDL_SCANCODE_UP: u32 = 82
val SDL_SCANCODE_LCTRL: u32 = 224
val SDL_SCANCODE_LSHIFT: u32 = 225
val SDL_SCANCODE_LALT: u32 = 226
val SDL_SCANCODE_COUNT: u32 = 512
