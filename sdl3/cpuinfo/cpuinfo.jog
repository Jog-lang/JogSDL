// Raw SDL3 cpuinfo — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.
import std.c

@link("SDL3")
extern {
    fn SDL_GetNumLogicalCPUCores(): c.int
    fn SDL_GetCPUCacheLineSize(): c.int
    fn SDL_HasAltiVec(): bool
    fn SDL_HasMMX(): bool
    fn SDL_HasSSE(): bool
    fn SDL_HasSSE2(): bool
    fn SDL_HasSSE3(): bool
    fn SDL_HasSSE41(): bool
    fn SDL_HasSSE42(): bool
    fn SDL_HasAVX(): bool
    fn SDL_HasAVX2(): bool
    fn SDL_HasAVX512F(): bool
    fn SDL_HasARMSIMD(): bool
    fn SDL_HasNEON(): bool
    fn SDL_HasLSX(): bool
    fn SDL_HasLASX(): bool
    fn SDL_GetSystemRAM(): c.int
    fn SDL_GetSIMDAlignment(): c.size_t
    fn SDL_GetSystemPageSize(): c.int
}
