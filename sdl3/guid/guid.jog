// Raw SDL3 GUID (SDL_guid.h).
import std.c

struct SDL_GUID {
    data: [16]u8
}

// Raw SDL3 guid — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.

@link("SDL3")
extern {
    fn SDL_GUIDToString(guid: SDL_GUID, pszGUID: *c.char, cbGUID: c.int)
    fn SDL_StringToGUID(pchGUID: *const c.char): SDL_GUID
}
