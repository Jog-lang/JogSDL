// Internal raw SDL3 bindings. Not exported from jog.mod — apps use jog_sdl.sdl.
// Expand as more APIs are needed. Spec shape: design/language/CInterop.md.
import std.c

@link("SDL3")
extern {
    fn SDL_Init(flags: u32): bool
    fn SDL_Quit()
    fn SDL_CreateWindow(title: *const c.char, w: c.int, h: c.int, flags: u64): *SDL_Window?
    fn SDL_DestroyWindow(window: *SDL_Window)
    fn SDL_CreateRenderer(window: *SDL_Window, name: *const c.char?): *SDL_Renderer?
    fn SDL_DestroyRenderer(renderer: *SDL_Renderer)
    fn SDL_CreateWindowAndRenderer(
        title: *const c.char,
        w: c.int,
        h: c.int,
        flags: u64,
        window: **SDL_Window,
        renderer: **SDL_Renderer
    ): bool
    fn SDL_SetRenderDrawColor(renderer: *SDL_Renderer, r: u8, g: u8, b: u8, a: u8): bool
    fn SDL_RenderClear(renderer: *SDL_Renderer): bool
    fn SDL_RenderPresent(renderer: *SDL_Renderer): bool
    fn SDL_RenderFillRect(renderer: *SDL_Renderer, rect: *const SDL_FRect): bool
    fn SDL_CreateTexture(
        renderer: *SDL_Renderer,
        format: u32,
        access: c.int,
        w: c.int,
        h: c.int
    ): *SDL_Texture?
    fn SDL_DestroyTexture(texture: *SDL_Texture)
    fn SDL_UpdateTexture(
        texture: *SDL_Texture,
        rect: *const SDL_Rect?,
        pixels: *const void,
        pitch: c.int
    ): bool
    fn SDL_RenderTexture(
        renderer: *SDL_Renderer,
        texture: *SDL_Texture,
        srcrect: *const SDL_FRect?,
        dstrect: *const SDL_FRect?
    ): bool
    fn SDL_PollEvent(event: *SDL_Event): bool
    fn SDL_GetKeyboardState(numkeys: *c.int): *const u8
    fn SDL_Delay(ms: u32)
    fn SDL_GetTicks(): u64
    fn SDL_GetError(): *const c.char
}

@opaque struct SDL_Window
@opaque struct SDL_Renderer
@opaque struct SDL_Texture

// Layout matches SDL_Event (128 bytes). Leading fields align with SDL_KeyboardEvent
// so key polls can read scancode without a separate union view.
struct SDL_Event {
    event_type: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    which: u32
    scancode: u32
    _pad: [100]u8
}

struct SDL_FRect {
    x: f32
    y: f32
    w: f32
    h: f32
}

struct SDL_Rect {
    x: c.int
    y: c.int
    w: c.int
    h: c.int
}

fn zero_event(): SDL_Event {
    var e: SDL_Event
    return e
}

fn frect(x: f32, y: f32, w: f32, h: f32): SDL_FRect {
    var r: SDL_FRect
    r.x = x
    r.y = y
    r.w = w
    r.h = h
    return r
}
