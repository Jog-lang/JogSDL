// Raw SDL3 gpu — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.
import std.c
import sdl3.video
import sdl3.rect
import sdl3.pixels

@opaque struct SDL_GPUDevice
@opaque struct SDL_GPUBuffer
@opaque struct SDL_GPUTransferBuffer
