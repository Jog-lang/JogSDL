    fn SDL_CopyGPUBufferToBuffer(copy_pass: *SDL_GPUCopyPass, source: *const void, destination: *const void, size: u32, cycle: bool)
    fn SDL_DownloadFromGPUTexture(copy_pass: *SDL_GPUCopyPass, source: *const void, destination: *const void)
    fn SDL_DownloadFromGPUBuffer(copy_pass: *SDL_GPUCopyPass, source: *const void, destination: *const void)
    fn SDL_EndGPUCopyPass(copy_pass: *SDL_GPUCopyPass)
