@opaque struct SDL_GPUSampler
@opaque struct SDL_GPUShader
@opaque struct SDL_GPUComputePipeline
@opaque struct SDL_GPUGraphicsPipeline
@opaque struct SDL_GPUCommandBuffer
@opaque struct SDL_GPURenderPass
@opaque struct SDL_GPUComputePass
@opaque struct SDL_GPUCopyPass
@opaque struct SDL_GPUFence

@link("SDL3")
extern {
    fn SDL_GPUSupportsShaderFormats(format_flags: u32, name: *const c.char): bool
    fn SDL_GPUSupportsProperties(props: u32): bool
