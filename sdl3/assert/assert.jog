// Raw SDL3 assert — generated from headers; hand-maintain.
// Unexported — apps use jog_sdl.sdl*.

@link("SDL3")
extern {
    fn SDL_SetAssertionHandler(handler: *void, userdata: *void)
    fn SDL_GetDefaultAssertionHandler(): *void
    fn SDL_GetAssertionHandler(puserdata: **void): *void
    fn SDL_GetAssertionReport(): *const void
    fn SDL_ResetAssertionReport()
}
