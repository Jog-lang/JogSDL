// Idiomatic wrappers over sdl3.cpuinfo.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.cpuinfo as raw
import sdl
import std.c

fn GetNumLogicalCPUCores(): c.int {
    return raw.SDL_GetNumLogicalCPUCores()
}

fn GetCPUCacheLineSize(): c.int {
    return raw.SDL_GetCPUCacheLineSize()
}

fn HasAltiVec(): sdl.SDLError? {
    if !raw.SDL_HasAltiVec() {
        return sdl.last_error("HasAltiVec failed")
    }
    return null
}

fn HasMMX(): sdl.SDLError? {
    if !raw.SDL_HasMMX() {
        return sdl.last_error("HasMMX failed")
    }
    return null
}

