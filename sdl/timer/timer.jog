// Timer wrappers (v2 flat merge).

/**
 * Sleep for approximately `ms` milliseconds.
 * @see https://wiki.libsdl.org/SDL3/SDL_Delay
 */
fn Delay(ms: u32) {
    SDL_Delay(ms)
}

/**
 * Milliseconds since SDL init (wrapping 64-bit).
 * @see https://wiki.libsdl.org/SDL3/SDL_GetTicks
 */
fn GetTicks(): u64 {
    return SDL_GetTicks()
}
