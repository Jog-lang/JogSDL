// Timer wrappers (v2 flat merge).

/**
 * Wait at least `ms` milliseconds before returning (may be longer due to OS scheduling).
 * @param ms delay in milliseconds
 * @see https://wiki.libsdl.org/SDL3/SDL_Delay
 */
fn Delay(ms: u32) {
    SDL_Delay(ms)
}

/**
 * Milliseconds since SDL library init (Uint64; wraps after ~584 million years).
 * @return ms since Init
 * @see https://wiki.libsdl.org/SDL3/SDL_GetTicks
 */
fn GetTicks(): u64 {
    return SDL_GetTicks()
}
