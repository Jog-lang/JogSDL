// Idiomatic v2 wrappers for SDL guid (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GUIDToString(guid: i32, pszGUID: *byte, cbGUID: i32): i32 {
    return SDL_GUIDToString(guid, pszGUID, cbGUID)
}

fn StringToGUID(pchGUID: *byte): i32 {
    return SDL_StringToGUID(pchGUID)
}

