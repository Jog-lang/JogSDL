}

fn GetAudioStreamData(stream: *raw.SDL_AudioStream, buf: *void, len: c.int): c.int {
    return raw.SDL_GetAudioStreamData(stream, buf, len)
}

fn GetAudioStreamAvailable(stream: *raw.SDL_AudioStream): c.int {
    return raw.SDL_GetAudioStreamAvailable(stream)
}

fn GetAudioStreamQueued(stream: *raw.SDL_AudioStream): c.int {
    return raw.SDL_GetAudioStreamQueued(stream)
