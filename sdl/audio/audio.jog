// Idiomatic wrappers over sdl3.audio.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.audio as raw
import sdl3.iostream
import sdl
import std.c

struct AudioStream {
    ptr: *raw.SDL_AudioStream?
}

fn empty_audiostream(): AudioStream {
    var h: AudioStream
    return h
}

fn GetNumAudioDrivers(): c.int {
    return raw.SDL_GetNumAudioDrivers()
}

fn GetAudioDriver(index: c.int): *const c.char {
    return raw.SDL_GetAudioDriver(index)
}

fn GetCurrentAudioDriver(): *const c.char {
    return raw.SDL_GetCurrentAudioDriver()
}

fn GetAudioPlaybackDevices(count: *c.int): *u32 {
    return raw.SDL_GetAudioPlaybackDevices(count)
}

fn GetAudioRecordingDevices(count: *c.int): *u32 {
    return raw.SDL_GetAudioRecordingDevices(count)
}

fn GetAudioDeviceName(devid: u32): *const c.char {
    return raw.SDL_GetAudioDeviceName(devid)
}

fn GetAudioDeviceFormat(devid: u32, spec: *raw.SDL_AudioSpec, sample_frames: *c.int): sdl.SDLError? {
    if !raw.SDL_GetAudioDeviceFormat(devid, spec, sample_frames) {
        return sdl.last_error("GetAudioDeviceFormat failed")
    }
    return null
}

fn GetAudioDeviceChannelMap(devid: u32, count: *c.int): *c.int {
    return raw.SDL_GetAudioDeviceChannelMap(devid, count)
}

fn OpenAudioDevice(devid: u32, spec: *const raw.SDL_AudioSpec): u32 {
    return raw.SDL_OpenAudioDevice(devid, spec)
}

fn IsAudioDevicePhysical(devid: u32): sdl.SDLError? {
    if !raw.SDL_IsAudioDevicePhysical(devid) {
        return sdl.last_error("IsAudioDevicePhysical failed")
    }
    return null
}

fn IsAudioDevicePlayback(devid: u32): sdl.SDLError? {
    if !raw.SDL_IsAudioDevicePlayback(devid) {
        return sdl.last_error("IsAudioDevicePlayback failed")
    }
    return null
}

fn PauseAudioDevice(devid: u32): sdl.SDLError? {
    if !raw.SDL_PauseAudioDevice(devid) {
        return sdl.last_error("PauseAudioDevice failed")
    }
    return null
}

fn ResumeAudioDevice(devid: u32): sdl.SDLError? {
    if !raw.SDL_ResumeAudioDevice(devid) {
        return sdl.last_error("ResumeAudioDevice failed")
    }
    return null
}

fn AudioDevicePaused(devid: u32): sdl.SDLError? {
    if !raw.SDL_AudioDevicePaused(devid) {
        return sdl.last_error("AudioDevicePaused failed")
    }
    return null
}

fn GetAudioDeviceGain(devid: u32): f32 {
    return raw.SDL_GetAudioDeviceGain(devid)
}

fn SetAudioDeviceGain(devid: u32, gain: f32): sdl.SDLError? {
    if !raw.SDL_SetAudioDeviceGain(devid, gain) {
        return sdl.last_error("SetAudioDeviceGain failed")
    }
    return null
}

fn CloseAudioDevice(devid: u32) {
    raw.SDL_CloseAudioDevice(devid)
}

fn BindAudioStreams(devid: u32, streams: **raw.SDL_AudioStream, num_streams: c.int): sdl.SDLError? {
    if !raw.SDL_BindAudioStreams(devid, streams, num_streams) {
        return sdl.last_error("BindAudioStreams failed")
    }
    return null
}

fn BindAudioStream(devid: u32, stream: *raw.SDL_AudioStream): sdl.SDLError? {
    if !raw.SDL_BindAudioStream(devid, stream) {
        return sdl.last_error("BindAudioStream failed")
    }
    return null
}

fn UnbindAudioStreams(streams: **raw.SDL_AudioStream, num_streams: c.int) {
    raw.SDL_UnbindAudioStreams(streams, num_streams)
}

fn UnbindAudioStream(stream: *raw.SDL_AudioStream) {
    raw.SDL_UnbindAudioStream(stream)
}

fn GetAudioStreamDevice(stream: *raw.SDL_AudioStream): u32 {
    return raw.SDL_GetAudioStreamDevice(stream)
}

fn CreateAudioStream(src_spec: *const raw.SDL_AudioSpec, dst_spec: *const raw.SDL_AudioSpec): *raw.SDL_AudioStream {
    return raw.SDL_CreateAudioStream(src_spec, dst_spec)
}

fn GetAudioStreamProperties(stream: *raw.SDL_AudioStream): u32 {
    return raw.SDL_GetAudioStreamProperties(stream)
}

fn GetAudioStreamFormat(stream: *raw.SDL_AudioStream, src_spec: *raw.SDL_AudioSpec, dst_spec: *raw.SDL_AudioSpec): sdl.SDLError? {
    if !raw.SDL_GetAudioStreamFormat(stream, src_spec, dst_spec) {
        return sdl.last_error("GetAudioStreamFormat failed")
    }
    return null
}

fn SetAudioStreamFormat(stream: *raw.SDL_AudioStream, src_spec: *const raw.SDL_AudioSpec, dst_spec: *const raw.SDL_AudioSpec): sdl.SDLError? {
