fn LoadWAV_IO(src: *iostream.SDL_IOStream, closeio: bool, spec: *raw.SDL_AudioSpec, audio_buf: **u8, audio_len: *u32): sdl.SDLError? {
    if !raw.SDL_LoadWAV_IO(src, closeio, spec, audio_buf, audio_len) {
        return sdl.last_error("LoadWAV_IO failed")
    }
    return null
}

fn LoadWAV(path: *const c.char, spec: *raw.SDL_AudioSpec, audio_buf: **u8, audio_len: *u32): sdl.SDLError? {
    if !raw.SDL_LoadWAV(path, spec, audio_buf, audio_len) {
        return sdl.last_error("LoadWAV failed")
    }
    return null
}

fn MixAudio(dst: *u8, src: *const u8, format: u32, len: u32, volume: f32): sdl.SDLError? {
    if !raw.SDL_MixAudio(dst, src, format, len, volume) {
        return sdl.last_error("MixAudio failed")
    }
    return null
}

fn ConvertAudioSamples(src_spec: *const raw.SDL_AudioSpec, src_data: *const u8, src_len: c.int, dst_spec: *const raw.SDL_AudioSpec, dst_data: **u8, dst_len: *c.int): sdl.SDLError? {
    if !raw.SDL_ConvertAudioSamples(src_spec, src_data, src_len, dst_spec, dst_data, dst_len) {
        return sdl.last_error("ConvertAudioSamples failed")
    }
    return null
}

fn GetAudioFormatName(format: u32): *const c.char {
    return raw.SDL_GetAudioFormatName(format)
}

fn GetSilenceValueForFormat(format: u32): c.int {
    return raw.SDL_GetSilenceValueForFormat(format)
}
