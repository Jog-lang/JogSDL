    return raw.SDL_GetAudioStreamInputChannelMap(stream, count)
}

fn GetAudioStreamOutputChannelMap(stream: *raw.SDL_AudioStream, count: *c.int): *c.int {
    return raw.SDL_GetAudioStreamOutputChannelMap(stream, count)
}

