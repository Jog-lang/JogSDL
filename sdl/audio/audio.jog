fn SetAudioStreamGain(stream: *raw.SDL_AudioStream, gain: f32): sdl.SDLError? {
    if !raw.SDL_SetAudioStreamGain(stream, gain) {
        return sdl.last_error("SetAudioStreamGain failed")
    }
    return null
}

