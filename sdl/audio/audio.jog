fn AudioStream.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyAudioStream(self.ptr!!)
    }
}

fn OpenAudioDeviceStream(devid: u32, spec: *const raw.SDL_AudioSpec, callback: *void, userdata: *void): *raw.SDL_AudioStream {
    return raw.SDL_OpenAudioDeviceStream(devid, spec, callback, userdata)
}

