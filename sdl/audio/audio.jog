fn PutAudioStreamPlanarData(stream: *raw.SDL_AudioStream, channel_buffers: **void, num_channels: c.int, num_samples: c.int): sdl.SDLError? {
    if !raw.SDL_PutAudioStreamPlanarData(stream, channel_buffers, num_channels, num_samples) {
        return sdl.last_error("PutAudioStreamPlanarData failed")
    }
