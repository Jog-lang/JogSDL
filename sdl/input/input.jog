// Keyboard / mouse helpers (v2 flat merge).

/// Relative mouse delta in logical pixels (Jog f64 after soft f32 promote).
struct MouseDelta {
    x: f64
    y: f64
}

/**
 * True when the scancode is currently down in the keyboard state array.
 * @param scancode physical key (SDL_Scancode value)
 * @return true if down, false if up or out of range
 * @see https://wiki.libsdl.org/SDL3/SDL_GetKeyboardState
 */
fn KeyboardIsDown(scancode: Scancode): bool {
    var n: i32 = 0
    // Must annotate `*byte`: untyped extern returns were inferred as scalar `byte`,
    // so `state[sc]` used stride-8 downward index and never saw real keys.
    val state: *byte = SDL_GetKeyboardState(&n)
    if (state == null) {
        return false
    }
    val sc = scancode as u32
    if ((sc as i32) < 0 || (sc as i32) >= n) {
        return false
    }
    return state[sc] != 0
}

/**
 * Promote an IEEE f32 stored in the low 4 bytes of an 8-byte Jog slot to f64.
 * Needed because SDL writes f32 into buffers that Jog loads as qword.
 * @param p pointer to four IEEE f32 bytes
 * @return soft-converted f64
 */
fn f32_slot_to_f64(p: *byte): f64 {
    val b0 = p[0]
    val b1 = p[1]
    val b2 = p[2]
    val b3 = p[3]
    val bits = b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
    return f32bits_to_f64(bits)
}

/**
 * Promote IEEE f32 bit pattern to f64 via compiler builtin (JogCompiler #43).
 * @param bits_in low 32 bits = IEEE f32 pattern
 * @return f64 value
 */
fn f32bits_to_f64(bits_in: i64): f64 {
    return f32_from_bits((bits_in & 4294967295) as u32)
}

/**
 * Relative mouse motion since the last call, as Jog f64 deltas.
 * Reads SDL f32 out-params into a scratch buffer and promotes via f32_from_bits
 * (JogCompiler #43 f32_from_bits).
 * @return MouseDelta with x/y in logical pixels (may be zero if unchanged)
 * @see https://wiki.libsdl.org/SDL3/SDL_GetRelativeMouseState
 */
fn GetRelativeMouseDelta(): MouseDelta {
    val buf = alloc(8)
    SDL_GetRelativeMouseState(buf, buf + 4)
    return MouseDelta(x: f32_slot_to_f64(buf), y: f32_slot_to_f64(buf + 4))
}

/**
 * Relative mouse delta (same as GetRelativeMouseDelta; preferred demo name).
 * @return MouseDelta with x/y in logical pixels
 * @see https://wiki.libsdl.org/SDL3/SDL_GetRelativeMouseState
 */
fn ReadRelativeMouseDelta(): MouseDelta {
    return GetRelativeMouseDelta()
}

/**
 * Write relative mouse x/y as IEEE f32 into out buffers; return button bitmask.
 * Friction / wasm twin — prefer `GetRelativeMouseDelta` / `ReadRelativeMouseDelta`
 * when MouseDelta returns are allowed on the call path.
 * @param out_x destination for f32 x (4 bytes)
 * @param out_y destination for f32 y (4 bytes)
 * @return SDL mouse button bitmask
 * @see https://wiki.libsdl.org/SDL3/SDL_GetRelativeMouseState
 */
fn ReadRelativeMouse(out_x: *byte, out_y: *byte): u32 {
    return SDL_GetRelativeMouseState(out_x, out_y)
}
