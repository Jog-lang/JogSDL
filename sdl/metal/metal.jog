// Idiomatic v2 wrappers for SDL metal (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn Metal_CreateView(window: *byte): i32 {
    return SDL_Metal_CreateView(window)
}

fn Metal_DestroyView(view: i32): i32 {
    return SDL_Metal_DestroyView(view)
}

fn Metal_GetLayer(view: i32): i32 {
    return SDL_Metal_GetLayer(view)
}

