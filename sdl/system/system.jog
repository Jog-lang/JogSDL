fn RequestAndroidPermission(permission: *const c.char, cb: *void, userdata: *void): sdl.SDLError? {
    if !raw.SDL_RequestAndroidPermission(permission, cb, userdata) {
        return sdl.last_error("RequestAndroidPermission failed")
    }
    return null
}

fn ShowAndroidToast(message: *const c.char, duration: c.int, gravity: c.int, xoffset: c.int, yoffset: c.int): sdl.SDLError? {
    if !raw.SDL_ShowAndroidToast(message, duration, gravity, xoffset, yoffset) {
        return sdl.last_error("ShowAndroidToast failed")
    }
    return null
}

fn SendAndroidMessage(command: u32, param: c.int): sdl.SDLError? {
    if !raw.SDL_SendAndroidMessage(command, param) {
        return sdl.last_error("SendAndroidMessage failed")
    }
    return null
}

fn IsTablet(): sdl.SDLError? {
    if !raw.SDL_IsTablet() {
        return sdl.last_error("IsTablet failed")
    }
    return null
}

fn IsTV(): sdl.SDLError? {
