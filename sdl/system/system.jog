// Idiomatic v2 wrappers for SDL system (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetDirect3D9AdapterIndex(displayID: u32): i32 {
    return SDL_GetDirect3D9AdapterIndex(displayID)
}

fn GetDXGIOutputInfo(displayID: u32, adapterIndex: *byte, outputIndex: *byte): i32 {
    return SDL_GetDXGIOutputInfo(displayID, adapterIndex, outputIndex)
}

fn SetLinuxThreadPriority(threadID: i64, priority: i32): i32 {
    return SDL_SetLinuxThreadPriority(threadID, priority)
}

fn SetLinuxThreadPriorityAndPolicy(threadID: i64, sdlPriority: i32, schedPolicy: i32): i32 {
    return SDL_SetLinuxThreadPriorityAndPolicy(threadID, sdlPriority, schedPolicy)
}

fn SetiOSEventPump(enabled: i32) {
    SDL_SetiOSEventPump(enabled)
}

fn GetAndroidJNIEnv(): *byte {
    return SDL_GetAndroidJNIEnv()
}

fn GetAndroidActivity(): *byte {
    return SDL_GetAndroidActivity()
}

fn GetAndroidSDKVersion(): i32 {
    return SDL_GetAndroidSDKVersion()
}

fn IsChromebook(): i32 {
    return SDL_IsChromebook()
}

fn IsDeXMode(): i32 {
    return SDL_IsDeXMode()
}

fn SendAndroidBackButton() {
    SDL_SendAndroidBackButton()
}

fn GetAndroidInternalStoragePath(): *byte {
    return SDL_GetAndroidInternalStoragePath()
}

fn GetAndroidExternalStorageState(): u32 {
    return SDL_GetAndroidExternalStorageState()
}

fn GetAndroidExternalStoragePath(): *byte {
    return SDL_GetAndroidExternalStoragePath()
}

fn GetAndroidCachePath(): *byte {
    return SDL_GetAndroidCachePath()
}

fn ShowAndroidToast(message: *byte, duration: i32, gravity: i32, xoffset: i32, yoffset: i32): i32 {
    return SDL_ShowAndroidToast(message, duration, gravity, xoffset, yoffset)
}

fn SendAndroidMessage(command: u32, param: i32): i32 {
    return SDL_SendAndroidMessage(command, param)
}

fn IsTablet(): i32 {
    return SDL_IsTablet()
}

fn IsTV(): i32 {
    return SDL_IsTV()
}

fn OnApplicationWillTerminate() {
    SDL_OnApplicationWillTerminate()
}

fn OnApplicationDidReceiveMemoryWarning() {
    SDL_OnApplicationDidReceiveMemoryWarning()
}

fn OnApplicationWillEnterBackground() {
    SDL_OnApplicationWillEnterBackground()
}

fn OnApplicationDidEnterBackground() {
    SDL_OnApplicationDidEnterBackground()
}

fn OnApplicationWillEnterForeground() {
    SDL_OnApplicationWillEnterForeground()
}

fn OnApplicationDidEnterForeground() {
    SDL_OnApplicationDidEnterForeground()
}

fn OnApplicationDidChangeStatusBarOrientation() {
    SDL_OnApplicationDidChangeStatusBarOrientation()
}

fn GetSandbox(): *byte {
    return SDL_GetSandbox()
}

fn RequestAndroidPermission(permission: *byte, cb: *byte, userdata: *byte): i32 {
    return SDL_RequestAndroidPermission(permission, cb, userdata)
}

fn SetiOSAnimationCallback(window: *byte, interval: i32, callback: *byte, callbackParam: *byte): i32 {
    return SDL_SetiOSAnimationCallback(window, interval, callback, callbackParam)
}

