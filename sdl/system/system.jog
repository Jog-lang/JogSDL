// Idiomatic wrappers over sdl3.system.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.system as raw
import sdl3.video
import sdl
import std.c

fn GetDirect3D9AdapterIndex(displayID: u32): c.int {
    return raw.SDL_GetDirect3D9AdapterIndex(displayID)
}

fn GetDXGIOutputInfo(displayID: u32, adapterIndex: *c.int, outputIndex: *c.int): sdl.SDLError? {
    if !raw.SDL_GetDXGIOutputInfo(displayID, adapterIndex, outputIndex) {
        return sdl.last_error("GetDXGIOutputInfo failed")
    }
    return null
}

fn SetLinuxThreadPriority(threadID: i64, priority: c.int): sdl.SDLError? {
    if !raw.SDL_SetLinuxThreadPriority(threadID, priority) {
        return sdl.last_error("SetLinuxThreadPriority failed")
    }
    return null
}

fn SetLinuxThreadPriorityAndPolicy(threadID: i64, sdlPriority: c.int, schedPolicy: c.int): sdl.SDLError? {
    if !raw.SDL_SetLinuxThreadPriorityAndPolicy(threadID, sdlPriority, schedPolicy) {
        return sdl.last_error("SetLinuxThreadPriorityAndPolicy failed")
    }
    return null
}

fn SetiOSAnimationCallback(window: *video.SDL_Window, interval: c.int, callback: *void, callbackParam: *void): sdl.SDLError? {
    if !raw.SDL_SetiOSAnimationCallback(window, interval, callback, callbackParam) {
        return sdl.last_error("SetiOSAnimationCallback failed")
    }
    return null
}

fn SetiOSEventPump(enabled: bool) {
    raw.SDL_SetiOSEventPump(enabled)
}

fn GetAndroidJNIEnv(): *void {
    return raw.SDL_GetAndroidJNIEnv()
}

fn GetAndroidActivity(): *void {
    return raw.SDL_GetAndroidActivity()
}

fn GetAndroidSDKVersion(): c.int {
    return raw.SDL_GetAndroidSDKVersion()
}

fn IsChromebook(): sdl.SDLError? {
