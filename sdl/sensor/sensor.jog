// Idiomatic v2 wrappers for SDL sensor (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetSensors(count: *byte): *byte {
    return SDL_GetSensors(count)
}

fn GetSensorNameForID(instance_id: u32): *byte {
    return SDL_GetSensorNameForID(instance_id)
}

fn GetSensorNonPortableTypeForID(instance_id: u32): i32 {
    return SDL_GetSensorNonPortableTypeForID(instance_id)
}

fn OpenSensor(instance_id: u32): *byte {
    return SDL_OpenSensor(instance_id)
}

fn GetSensorFromID(instance_id: u32): *byte {
    return SDL_GetSensorFromID(instance_id)
}

fn GetSensorProperties(sensor: *byte): u32 {
    return SDL_GetSensorProperties(sensor)
}

fn GetSensorName(sensor: *byte): *byte {
    return SDL_GetSensorName(sensor)
}

fn GetSensorNonPortableType(sensor: *byte): i32 {
    return SDL_GetSensorNonPortableType(sensor)
}

fn GetSensorID(sensor: *byte): u32 {
    return SDL_GetSensorID(sensor)
}

fn GetSensorData(sensor: *byte, data: *byte, num_values: i32): i32 {
    return SDL_GetSensorData(sensor, data, num_values)
}

fn CloseSensor(sensor: *byte) {
    SDL_CloseSensor(sensor)
}

fn UpdateSensors() {
    SDL_UpdateSensors()
}

