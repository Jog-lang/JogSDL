// Idiomatic v2 wrappers for SDL loadso (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn LoadObject(sofile: *byte): *byte {
    return SDL_LoadObject(sofile)
}

fn UnloadObject(handle: *byte) {
    SDL_UnloadObject(handle)
}

fn LoadFunction(handle: *byte, name: *byte): i32 {
    return SDL_LoadFunction(handle, name)
}

