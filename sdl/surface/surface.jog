// Hand-written KEEP surface (typed handles). Thin *byte pass-throughs retired here.
// Generators must not overwrite this package (KEEP_DIRS / check-idiomatic-sdl.sh).

/// Opaque CPU surface handle with logical size (from create/load).
struct Surface {
    private ptr: *byte
    w: i32
    h: i32
}

/// True when the underlying SDL surface pointer is non-null.
fn Surface.ok(): bool {
    return self.ptr != null
}

/// Escape hatch for Friction paths that must stash an opaque pointer.
fn Surface.raw_ptr(): *byte {
    return self.ptr
}

/**
 * Destroy this surface.
 * Safe to call when the handle is empty (null ptr).
 * @see https://wiki.libsdl.org/SDL3/SDL_DestroySurface
 */
fn Surface.destroy() {
    if (self.ptr != null) {
        SDL_DestroySurface(self.ptr)
    }
}

/// Read SDL_Surface.w / .h (public layout: flags u32, format u32, w i32, h i32).
fn surface_wh_from_ptr(p: *byte): (i32, i32) {
    if (p == null) {
        return (0, 0)
    }
    val w0 = p[8] & 255
    val w1 = p[9] & 255
    val w2 = p[10] & 255
    val w3 = p[11] & 255
    val h0 = p[12] & 255
    val h1 = p[13] & 255
    val h2 = p[14] & 255
    val h3 = p[15] & 255
    val w = (w0 + (w1 << 8) + (w2 << 16) + (w3 << 24)) as i32
    val h = (h0 + (h1 << 8) + (h2 << 16) + (h3 << 24)) as i32
    return (w, h)
}

/**
 * Allocate a new surface with a specific pixel format (pixels zeroed).
 * @param w width in pixels
 * @param h height in pixels
 * @param format SDL_PixelFormat value (e.g. PIXELFORMAT_ARGB8888)
 * @return (Surface, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateSurface
 */
fn CreateSurface(w: i32, h: i32, format: u32): (Surface, SDLError?) {
    val p = SDL_CreateSurface(w, h, format)
    if (p == null) {
        return (Surface(ptr: null, w: 0, h: 0), last_error("CreateSurface failed"))
    }
    return (Surface(ptr: p, w: w, h: h), null)
}

/**
 * Load a BMP file into a new surface.
 * Path must be a NUL-terminated C string (`c"…"`).
 * @param file filesystem path
 * @return (Surface, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_LoadBMP
 */
fn LoadBMP(file: *byte): (Surface, SDLError?) {
    val p = SDL_LoadBMP(file)
    if (p == null) {
        return (Surface(ptr: null, w: 0, h: 0), last_error("LoadBMP failed"))
    }
    val (w, h) = surface_wh_from_ptr(p)
    return (Surface(ptr: p, w: w, h: h), null)
}

/**
 * Load a PNG file into a new surface (SDL 3.2+ built-in PNG).
 * Path must be a NUL-terminated C string (`c"…"`).
 * @param file filesystem path
 * @return (Surface, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_LoadPNG
 */
fn LoadPNG(file: *byte): (Surface, SDLError?) {
    val p = SDL_LoadPNG(file)
    if (p == null) {
        return (Surface(ptr: null, w: 0, h: 0), last_error("LoadPNG failed"))
    }
    val (w, h) = surface_wh_from_ptr(p)
    return (Surface(ptr: p, w: w, h: h), null)
}
