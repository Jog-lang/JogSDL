fn ConvertPixels(width: c.int, height: c.int, src_format: u32, src: *const void, src_pitch: c.int, dst_format: u32, dst: *void, dst_pitch: c.int): sdl.SDLError? {
    if !raw.SDL_ConvertPixels(width, height, src_format, src, src_pitch, dst_format, dst, dst_pitch) {
        return sdl.last_error("ConvertPixels failed")
    }
    return null
}

fn ConvertPixelsAndColorspace(width: c.int, height: c.int, src_format: u32, src_colorspace: u32, src_properties: u32, src: *const void, src_pitch: c.int, dst_format: u32, dst_colorspace: u32, dst_properties: u32, dst: *void, dst_pitch: c.int): sdl.SDLError? {
    if !raw.SDL_ConvertPixelsAndColorspace(width, height, src_format, src_colorspace, src_properties, src, src_pitch, dst_format, dst_colorspace, dst_properties, dst, dst_pitch) {
        return sdl.last_error("ConvertPixelsAndColorspace failed")
    }
    return null
}

