// Idiomatic wrappers over sdl3.surface.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.surface as raw
import sdl3.iostream
import sdl3.rect
import sdl
import std.c

struct Surface {
    ptr: *raw.SDL_Surface?
}

fn empty_surface(): Surface {
    var h: Surface
    return h
}

fn CreateSurface(width: c.int, height: c.int, format: u32): *raw.SDL_Surface {
    return raw.SDL_CreateSurface(width, height, format)
}

fn CreateSurfaceFrom(width: c.int, height: c.int, format: u32, pixels: *void, pitch: c.int): *raw.SDL_Surface {
    return raw.SDL_CreateSurfaceFrom(width, height, format, pixels, pitch)
}

fn Surface.destroy() {
    if self.ptr != null {
        raw.SDL_DestroySurface(self.ptr!!)
    }
}

fn GetSurfaceProperties(surface: *raw.SDL_Surface): u32 {
    return raw.SDL_GetSurfaceProperties(surface)
}

fn SetSurfaceColorspace(surface: *raw.SDL_Surface, colorspace: u32): sdl.SDLError? {
    if !raw.SDL_SetSurfaceColorspace(surface, colorspace) {
        return sdl.last_error("SetSurfaceColorspace failed")
    }
    return null
}

fn GetSurfaceColorspace(surface: *raw.SDL_Surface): u32 {
    return raw.SDL_GetSurfaceColorspace(surface)
}

fn CreateSurfacePalette(surface: *raw.SDL_Surface): *void {
    return raw.SDL_CreateSurfacePalette(surface)
}

fn SetSurfacePalette(surface: *raw.SDL_Surface, palette: *void): sdl.SDLError? {
    if !raw.SDL_SetSurfacePalette(surface, palette) {
        return sdl.last_error("SetSurfacePalette failed")
    }
    return null
}

fn GetSurfacePalette(surface: *raw.SDL_Surface): *void {
    return raw.SDL_GetSurfacePalette(surface)
}

fn AddSurfaceAlternateImage(surface: *raw.SDL_Surface, image: *raw.SDL_Surface): sdl.SDLError? {
    if !raw.SDL_AddSurfaceAlternateImage(surface, image) {
        return sdl.last_error("AddSurfaceAlternateImage failed")
    }
    return null
}

fn SurfaceHasAlternateImages(surface: *raw.SDL_Surface): sdl.SDLError? {
    if !raw.SDL_SurfaceHasAlternateImages(surface) {
        return sdl.last_error("SurfaceHasAlternateImages failed")
    }
    return null
}

fn GetSurfaceImages(surface: *raw.SDL_Surface, count: *c.int): **raw.SDL_Surface {
    return raw.SDL_GetSurfaceImages(surface, count)
}

fn RemoveSurfaceAlternateImages(surface: *raw.SDL_Surface) {
    raw.SDL_RemoveSurfaceAlternateImages(surface)
}

fn LockSurface(surface: *raw.SDL_Surface): sdl.SDLError? {
    if !raw.SDL_LockSurface(surface) {
        return sdl.last_error("LockSurface failed")
    }
    return null
}

fn UnlockSurface(surface: *raw.SDL_Surface) {
    raw.SDL_UnlockSurface(surface)
}

fn LoadSurface_IO(src: *iostream.SDL_IOStream, closeio: bool): *raw.SDL_Surface {
    return raw.SDL_LoadSurface_IO(src, closeio)
}

fn LoadSurface(file: *const c.char): *raw.SDL_Surface {
    return raw.SDL_LoadSurface(file)
}

fn LoadBMP_IO(src: *iostream.SDL_IOStream, closeio: bool): *raw.SDL_Surface {
    return raw.SDL_LoadBMP_IO(src, closeio)
}

fn LoadBMP(file: *const c.char): *raw.SDL_Surface {
    return raw.SDL_LoadBMP(file)
}

fn SaveBMP_IO(surface: *raw.SDL_Surface, dst: *iostream.SDL_IOStream, closeio: bool): sdl.SDLError? {
    if !raw.SDL_SaveBMP_IO(surface, dst, closeio) {
        return sdl.last_error("SaveBMP_IO failed")
    }
