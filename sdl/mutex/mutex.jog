// Idiomatic v2 wrappers for SDL mutex (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn CreateMutex(): *byte {
    return SDL_CreateMutex()
}

fn LockMutex(mutex: *byte) {
    SDL_LockMutex(mutex)
}

fn TryLockMutex(mutex: *byte): i32 {
    return SDL_TryLockMutex(mutex)
}

fn UnlockMutex(mutex: *byte) {
    SDL_UnlockMutex(mutex)
}

fn DestroyMutex(mutex: *byte) {
    SDL_DestroyMutex(mutex)
}

fn CreateRWLock(): *byte {
    return SDL_CreateRWLock()
}

fn LockRWLockForReading(rwlock: *byte) {
    SDL_LockRWLockForReading(rwlock)
}

fn LockRWLockForWriting(rwlock: *byte) {
    SDL_LockRWLockForWriting(rwlock)
}

fn TryLockRWLockForReading(rwlock: *byte): i32 {
    return SDL_TryLockRWLockForReading(rwlock)
}

fn TryLockRWLockForWriting(rwlock: *byte): i32 {
    return SDL_TryLockRWLockForWriting(rwlock)
}

fn UnlockRWLock(rwlock: *byte) {
    SDL_UnlockRWLock(rwlock)
}

fn DestroyRWLock(rwlock: *byte) {
    SDL_DestroyRWLock(rwlock)
}

fn CreateSemaphore(initial_value: u32): *byte {
    return SDL_CreateSemaphore(initial_value)
}

fn DestroySemaphore(sem: *byte) {
    SDL_DestroySemaphore(sem)
}

fn WaitSemaphore(sem: *byte) {
    SDL_WaitSemaphore(sem)
}

fn TryWaitSemaphore(sem: *byte): i32 {
    return SDL_TryWaitSemaphore(sem)
}

fn WaitSemaphoreTimeout(sem: *byte, timeoutMS: i32): i32 {
    return SDL_WaitSemaphoreTimeout(sem, timeoutMS)
}

fn SignalSemaphore(sem: *byte) {
    SDL_SignalSemaphore(sem)
}

fn GetSemaphoreValue(sem: *byte): u32 {
    return SDL_GetSemaphoreValue(sem)
}

fn CreateCondition(): *byte {
    return SDL_CreateCondition()
}

fn DestroyCondition(cond: *byte) {
    SDL_DestroyCondition(cond)
}

fn SignalCondition(cond: *byte) {
    SDL_SignalCondition(cond)
}

fn BroadcastCondition(cond: *byte) {
    SDL_BroadcastCondition(cond)
}

fn WaitCondition(cond: *byte, mutex: *byte) {
    SDL_WaitCondition(cond, mutex)
}

fn WaitConditionTimeout(cond: *byte, mutex: *byte, timeoutMS: i32): i32 {
    return SDL_WaitConditionTimeout(cond, mutex, timeoutMS)
}

fn ShouldInit(state: *byte): i32 {
    return SDL_ShouldInit(state)
}

fn ShouldQuit(state: *byte): i32 {
    return SDL_ShouldQuit(state)
}

fn SetInitialized(state: *byte, initialized: i32) {
    SDL_SetInitialized(state, initialized)
}

