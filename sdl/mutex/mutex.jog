// Idiomatic wrappers over sdl3.mutex.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.mutex as raw
import sdl

struct Mutex {
    ptr: *raw.SDL_Mutex?
}

fn empty_mutex(): Mutex {
    var h: Mutex
    return h
}

struct RWLock {
    ptr: *raw.SDL_RWLock?
}

fn empty_rwlock(): RWLock {
    var h: RWLock
    return h
}

struct Semaphore {
    ptr: *raw.SDL_Semaphore?
}

fn empty_semaphore(): Semaphore {
    var h: Semaphore
    return h
}

struct Condition {
    ptr: *raw.SDL_Condition?
}

fn empty_condition(): Condition {
    var h: Condition
    return h
}

struct InitState {
    ptr: *raw.SDL_InitState?
}

fn empty_initstate(): InitState {
    var h: InitState
    return h
}

fn CreateMutex(): *raw.SDL_Mutex {
    return raw.SDL_CreateMutex()
}

fn LockMutex(mutex: *raw.SDL_Mutex) {
    raw.SDL_LockMutex(mutex)
}

fn TryLockMutex(mutex: *raw.SDL_Mutex): sdl.SDLError? {
    if !raw.SDL_TryLockMutex(mutex) {
        return sdl.last_error("TryLockMutex failed")
    }
    return null
}

fn UnlockMutex(mutex: *raw.SDL_Mutex) {
    raw.SDL_UnlockMutex(mutex)
}

fn Mutex.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyMutex(self.ptr!!)
    }
}

fn CreateRWLock(): *raw.SDL_RWLock {
    return raw.SDL_CreateRWLock()
}

fn LockRWLockForReading(rwlock: *raw.SDL_RWLock) {
    raw.SDL_LockRWLockForReading(rwlock)
}

fn LockRWLockForWriting(rwlock: *raw.SDL_RWLock) {
    raw.SDL_LockRWLockForWriting(rwlock)
}

fn TryLockRWLockForReading(rwlock: *raw.SDL_RWLock): sdl.SDLError? {
    if !raw.SDL_TryLockRWLockForReading(rwlock) {
        return sdl.last_error("TryLockRWLockForReading failed")
    }
    return null
}

fn TryLockRWLockForWriting(rwlock: *raw.SDL_RWLock): sdl.SDLError? {
    if !raw.SDL_TryLockRWLockForWriting(rwlock) {
        return sdl.last_error("TryLockRWLockForWriting failed")
    }
    return null
}

fn UnlockRWLock(rwlock: *raw.SDL_RWLock) {
    raw.SDL_UnlockRWLock(rwlock)
}

fn RWLock.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyRWLock(self.ptr!!)
    }
}

fn CreateSemaphore(initial_value: u32): *raw.SDL_Semaphore {
    return raw.SDL_CreateSemaphore(initial_value)
}

fn Semaphore.destroy() {
    if self.ptr != null {
        raw.SDL_DestroySemaphore(self.ptr!!)
    }
}

fn WaitSemaphore(sem: *raw.SDL_Semaphore) {
    raw.SDL_WaitSemaphore(sem)
}

fn TryWaitSemaphore(sem: *raw.SDL_Semaphore): sdl.SDLError? {
    if !raw.SDL_TryWaitSemaphore(sem) {
        return sdl.last_error("TryWaitSemaphore failed")
    }
    return null
}

fn WaitSemaphoreTimeout(sem: *raw.SDL_Semaphore, timeoutMS: i32): sdl.SDLError? {
    if !raw.SDL_WaitSemaphoreTimeout(sem, timeoutMS) {
        return sdl.last_error("WaitSemaphoreTimeout failed")
    }
    return null
}

fn SignalSemaphore(sem: *raw.SDL_Semaphore) {
    raw.SDL_SignalSemaphore(sem)
}

fn GetSemaphoreValue(sem: *raw.SDL_Semaphore): u32 {
    return raw.SDL_GetSemaphoreValue(sem)
}

fn CreateCondition(): *raw.SDL_Condition {
    return raw.SDL_CreateCondition()
}

fn Condition.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyCondition(self.ptr!!)
    }
}

fn SignalCondition(cond: *raw.SDL_Condition) {
    raw.SDL_SignalCondition(cond)
}

fn BroadcastCondition(cond: *raw.SDL_Condition) {
    raw.SDL_BroadcastCondition(cond)
}

fn WaitCondition(cond: *raw.SDL_Condition, mutex: *raw.SDL_Mutex) {
    raw.SDL_WaitCondition(cond, mutex)
}

fn WaitConditionTimeout(cond: *raw.SDL_Condition, mutex: *raw.SDL_Mutex, timeoutMS: i32): sdl.SDLError? {
    if !raw.SDL_WaitConditionTimeout(cond, mutex, timeoutMS) {
        return sdl.last_error("WaitConditionTimeout failed")
    }
    return null
}

fn ShouldInit(state: *raw.SDL_InitState): sdl.SDLError? {
    if !raw.SDL_ShouldInit(state) {
        return sdl.last_error("ShouldInit failed")
    }
    return null
}

fn ShouldQuit(state: *raw.SDL_InitState): sdl.SDLError? {
    if !raw.SDL_ShouldQuit(state) {
        return sdl.last_error("ShouldQuit failed")
    }
    return null
}

fn SetInitialized(state: *raw.SDL_InitState, initialized: bool) {
    raw.SDL_SetInitialized(state, initialized)
}
