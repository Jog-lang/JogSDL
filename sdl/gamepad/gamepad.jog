// Idiomatic wrappers over sdl3.gamepad.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.gamepad as raw
import sdl3.guid
import sdl3.iostream
import sdl3.joystick
import sdl
import std.c

struct Gamepad {
    ptr: *raw.SDL_Gamepad?
}

fn empty_gamepad(): Gamepad {
    var h: Gamepad
    return h
}

fn AddGamepadMapping(mapping: *const c.char): c.int {
    return raw.SDL_AddGamepadMapping(mapping)
}

fn AddGamepadMappingsFromIO(src: *iostream.SDL_IOStream, closeio: bool): c.int {
    return raw.SDL_AddGamepadMappingsFromIO(src, closeio)
}

fn AddGamepadMappingsFromFile(file: *const c.char): c.int {
    return raw.SDL_AddGamepadMappingsFromFile(file)
}

fn ReloadGamepadMappings(): sdl.SDLError? {
    if !raw.SDL_ReloadGamepadMappings() {
        return sdl.last_error("ReloadGamepadMappings failed")
    }
    return null
}

fn GetGamepadMappings(count: *c.int): **c.char {
    return raw.SDL_GetGamepadMappings(count)
}

fn GetGamepadMappingForGUID(guid: guid.SDL_GUID): *c.char {
    return raw.SDL_GetGamepadMappingForGUID(guid)
}

fn GetGamepadMapping(gamepad: *raw.SDL_Gamepad): *c.char {
    return raw.SDL_GetGamepadMapping(gamepad)
}

fn SetGamepadMapping(instance_id: u32, mapping: *const c.char): sdl.SDLError? {
    if !raw.SDL_SetGamepadMapping(instance_id, mapping) {
        return sdl.last_error("SetGamepadMapping failed")
    }
    return null
}

fn HasGamepad(): sdl.SDLError? {
    if !raw.SDL_HasGamepad() {
        return sdl.last_error("HasGamepad failed")
    }
    return null
}

fn GetGamepads(count: *c.int): *u32 {
    return raw.SDL_GetGamepads(count)
}

fn IsGamepad(instance_id: u32): sdl.SDLError? {
    if !raw.SDL_IsGamepad(instance_id) {
        return sdl.last_error("IsGamepad failed")
    }
    return null
}

