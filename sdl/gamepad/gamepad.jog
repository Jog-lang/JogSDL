fn GetGamepadType(gamepad: *raw.SDL_Gamepad): u32 {
    return raw.SDL_GetGamepadType(gamepad)
}

fn GetRealGamepadType(gamepad: *raw.SDL_Gamepad): u32 {
    return raw.SDL_GetRealGamepadType(gamepad)
