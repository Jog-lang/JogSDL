fn GetGamepadTypeForID(instance_id: u32): u32 {
    return raw.SDL_GetGamepadTypeForID(instance_id)
}

fn GetRealGamepadTypeForID(instance_id: u32): u32 {
    return raw.SDL_GetRealGamepadTypeForID(instance_id)
}

fn GetGamepadMappingForID(instance_id: u32): *c.char {
    return raw.SDL_GetGamepadMappingForID(instance_id)
}

fn OpenGamepad(instance_id: u32): *raw.SDL_Gamepad {
    return raw.SDL_OpenGamepad(instance_id)
