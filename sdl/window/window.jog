// Window wrappers (v2 flat merge).

struct Window {
    ptr: *byte
}

/**
 * Create a window.
 * @param title UTF-8 title (c"…" or *byte)
 * @param flags zero or more WindowFlag values (OR'd for SDL_CreateWindow)
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateWindow
 */
fn CreateWindow(title: *byte, w: i32, h: i32, ...WindowFlag: flags): Window {
    var bits: u64 = 0
    for f in flags {
        bits = bits | (f as u64)
    }
    var win = Window(ptr: null)
    win.ptr = SDL_CreateWindow(title, w, h, bits)
    return win
}

fn Window.destroy() {
    if (self.ptr != null) {
        SDL_DestroyWindow(self.ptr)
    }
}

fn Window.set_relative_mouse(enabled: i32): i32 {
    if (self.ptr == null) {
        return 0
    }
    return SDL_SetWindowRelativeMouseMode(self.ptr, enabled)
}

fn Window.create_renderer(): Renderer {
    var ren = Renderer(ptr: null)
    ren.ptr = SDL_CreateRenderer(self.ptr, null)
    return ren
}
