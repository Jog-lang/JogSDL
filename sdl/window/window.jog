// Window wrappers (v2 flat merge). Opaque SDL_Window* stays in `private ptr`.

/// Opaque window handle.
struct Window {
    private ptr: *byte
}

/**
 * Create a window with the given title, size, and flags.
 * Title is UTF-8; prefer `c"…"` (NUL-terminated) or a `str` whose bytes are
 * safe to pass to C. Internally forwarded to SDL_CreateWindow.
 * @param title UTF-8 window title
 * @param w width in screen coordinates
 * @param h height in screen coordinates
 * @param flags zero or more WindowFlag values (OR'd for SDL_CreateWindow)
 * @return (Window, null) on success; (empty Window, SDLError) on failure
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateWindow
 */
fn CreateWindow(title: str, w: i32, h: i32, ...WindowFlag: flags): (Window, SDLError?) {
    var bits: u64 = 0
    for f in flags {
        bits = bits | (f as u64)
    }
    val p = SDL_CreateWindow(title, w, h, bits)
    if (p == null) {
        return (Window(ptr: null), last_error("CreateWindow failed"))
    }
    return (Window(ptr: p), null)
}

/// True when the underlying SDL window pointer is non-null.
fn Window.ok(): bool {
    return self.ptr != null
}

/// Escape hatch for Friction paths that must stash an opaque pointer (wasm tick).
fn Window.raw_ptr(): *byte {
    return self.ptr
}

/**
 * Destroy this window and free associated resources.
 * Safe to call when the handle is empty (null ptr).
 * @see https://wiki.libsdl.org/SDL3/SDL_DestroyWindow
 */
fn Window.destroy() {
    if (self.ptr != null) {
        SDL_DestroyWindow(self.ptr)
    }
}

/**
 * Enable or disable relative mouse mode for this window.
 * When enabled, the cursor is hidden and continuous relative motion is reported.
 * @param enabled true to enable, false to disable
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_SetWindowRelativeMouseMode
 */
fn Window.set_relative_mouse(enabled: bool): SDLError? {
    if (self.ptr == null) {
        return last_error("set_relative_mouse: null window")
    }
    // sdl3 FFI stays C bool-as-i32; convert at the idiomatic boundary.
    if (SDL_SetWindowRelativeMouseMode(self.ptr, enabled as i32) == 0) {
        return last_error("SetWindowRelativeMouseMode failed")
    }
    return null
}

/**
 * Create a default renderer for this window (NULL name → SDL default backend).
 * @return (Renderer, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateRenderer
 */
fn Window.create_renderer(): (Renderer, SDLError?) {
    val p = SDL_CreateRenderer(self.ptr, null)
    if (p == null) {
        return (Renderer(ptr: null), last_error("CreateRenderer failed"))
    }
    return (Renderer(ptr: p), null)
}
