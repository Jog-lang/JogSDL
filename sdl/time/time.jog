// Idiomatic v2 wrappers for SDL time (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetDateTimeLocalePreferences(dateFormat: *byte, timeFormat: *byte): i32 {
    return SDL_GetDateTimeLocalePreferences(dateFormat, timeFormat)
}

fn GetCurrentTime(ticks: *byte): i32 {
    return SDL_GetCurrentTime(ticks)
}

fn TimeToDateTime(ticks: i64, dt: *byte, localTime: i32): i32 {
    return SDL_TimeToDateTime(ticks, dt, localTime)
}

fn DateTimeToTime(dt: *byte, ticks: *byte): i32 {
    return SDL_DateTimeToTime(dt, ticks)
}

fn TimeToWindows(ticks: i64, dwLowDateTime: *byte, dwHighDateTime: *byte) {
    SDL_TimeToWindows(ticks, dwLowDateTime, dwHighDateTime)
}

fn TimeFromWindows(dwLowDateTime: u32, dwHighDateTime: u32): i64 {
    return SDL_TimeFromWindows(dwLowDateTime, dwHighDateTime)
}

fn GetDaysInMonth(year: i32, month: i32): i32 {
    return SDL_GetDaysInMonth(year, month)
}

fn GetDayOfYear(year: i32, month: i32, day: i32): i32 {
    return SDL_GetDayOfYear(year, month, day)
}

fn GetDayOfWeek(year: i32, month: i32, day: i32): i32 {
    return SDL_GetDayOfWeek(year, month, day)
}

