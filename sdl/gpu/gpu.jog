fn WindowSupportsGPUSwapchainComposition(device: *raw.SDL_GPUDevice, window: *video.SDL_Window, swapchain_composition: u32): sdl.SDLError? {
    if !raw.SDL_WindowSupportsGPUSwapchainComposition(device, window, swapchain_composition) {
        return sdl.last_error("WindowSupportsGPUSwapchainComposition failed")
    }
    return null
}

