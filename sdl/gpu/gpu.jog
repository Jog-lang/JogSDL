// Idiomatic wrappers over sdl3.gpu.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.gpu as raw
import sdl3.pixels
import sdl3.rect
import sdl3.video
import sdl
import std.c

struct GPUDevice {
    ptr: *raw.SDL_GPUDevice?
}

fn empty_gpudevice(): GPUDevice {
    var h: GPUDevice
    return h
}

struct GPUBuffer {
    ptr: *raw.SDL_GPUBuffer?
}

fn empty_gpubuffer(): GPUBuffer {
    var h: GPUBuffer
    return h
}

struct GPUTransferBuffer {
    ptr: *raw.SDL_GPUTransferBuffer?
}

fn empty_gputransferbuffer(): GPUTransferBuffer {
    var h: GPUTransferBuffer
    return h
}

struct GPUTexture {
    ptr: *raw.SDL_GPUTexture?
}

fn empty_gputexture(): GPUTexture {
    var h: GPUTexture
    return h
}

struct GPUSampler {
    ptr: *raw.SDL_GPUSampler?
}

fn empty_gpusampler(): GPUSampler {
    var h: GPUSampler
    return h
}

struct GPUShader {
    ptr: *raw.SDL_GPUShader?
}

fn empty_gpushader(): GPUShader {
    var h: GPUShader
    return h
}

struct GPUComputePipeline {
    ptr: *raw.SDL_GPUComputePipeline?
}

fn empty_gpucomputepipeline(): GPUComputePipeline {
    var h: GPUComputePipeline
    return h
}

struct GPUGraphicsPipeline {
    ptr: *raw.SDL_GPUGraphicsPipeline?
}

fn empty_gpugraphicspipeline(): GPUGraphicsPipeline {
    var h: GPUGraphicsPipeline
    return h
}

struct GPUCommandBuffer {
    ptr: *raw.SDL_GPUCommandBuffer?
}

fn empty_gpucommandbuffer(): GPUCommandBuffer {
    var h: GPUCommandBuffer
    return h
}

struct GPURenderPass {
    ptr: *raw.SDL_GPURenderPass?
}

fn empty_gpurenderpass(): GPURenderPass {
    var h: GPURenderPass
    return h
}

struct GPUComputePass {
    ptr: *raw.SDL_GPUComputePass?
}

fn empty_gpucomputepass(): GPUComputePass {
    var h: GPUComputePass
    return h
}

struct GPUCopyPass {
    ptr: *raw.SDL_GPUCopyPass?
}

fn empty_gpucopypass(): GPUCopyPass {
    var h: GPUCopyPass
    return h
}

struct GPUFence {
    ptr: *raw.SDL_GPUFence?
}

fn empty_gpufence(): GPUFence {
    var h: GPUFence
    return h
}

fn GPUSupportsShaderFormats(format_flags: u32, name: *const c.char): sdl.SDLError? {
    if !raw.SDL_GPUSupportsShaderFormats(format_flags, name) {
        return sdl.last_error("GPUSupportsShaderFormats failed")
    }
    return null
}

fn GPUSupportsProperties(props: u32): sdl.SDLError? {
    if !raw.SDL_GPUSupportsProperties(props) {
        return sdl.last_error("GPUSupportsProperties failed")
    }
    return null
}

fn CreateGPUDevice(format_flags: u32, debug_mode: bool, name: *const c.char): *raw.SDL_GPUDevice {
    return raw.SDL_CreateGPUDevice(format_flags, debug_mode, name)
}

fn CreateGPUDeviceWithProperties(props: u32): *raw.SDL_GPUDevice {
    return raw.SDL_CreateGPUDeviceWithProperties(props)
}

fn GPUDevice.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyGPUDevice(self.ptr!!)
    }
}

fn GetNumGPUDrivers(): c.int {
    return raw.SDL_GetNumGPUDrivers()
}

fn GetGPUDriver(index: c.int): *const c.char {
    return raw.SDL_GetGPUDriver(index)
}

fn GetGPUDeviceDriver(device: *raw.SDL_GPUDevice): *const c.char {
