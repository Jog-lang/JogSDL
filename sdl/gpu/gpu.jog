// Idiomatic v2 wrappers for SDL gpu (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GPUSupportsProperties(props: u32): i32 {
    return SDL_GPUSupportsProperties(props)
}

fn CreateGPUDeviceWithProperties(props: u32): *byte {
    return SDL_CreateGPUDeviceWithProperties(props)
}

fn DestroyGPUDevice(device: *byte) {
