// Idiomatic wrappers over sdl3.init.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.init as raw
import sdl
import std.c

fn Init(flags: u32): sdl.SDLError? {
    if !raw.SDL_Init(flags) {
        return sdl.last_error("Init failed")
    }
    return null
}

fn InitSubSystem(flags: u32): sdl.SDLError? {
    if !raw.SDL_InitSubSystem(flags) {
        return sdl.last_error("InitSubSystem failed")
    }
    return null
}

fn QuitSubSystem(flags: u32) {
    raw.SDL_QuitSubSystem(flags)
}

fn WasInit(flags: u32): u32 {
    return raw.SDL_WasInit(flags)
}

fn Quit() {
    raw.SDL_Quit()
}

fn IsMainThread(): sdl.SDLError? {
    if !raw.SDL_IsMainThread() {
        return sdl.last_error("IsMainThread failed")
    }
    return null
}

fn RunOnMainThread(callback: *void, userdata: *void, wait_complete: bool): sdl.SDLError? {
    if !raw.SDL_RunOnMainThread(callback, userdata, wait_complete) {
        return sdl.last_error("RunOnMainThread failed")
    }
    return null
}

fn SetAppMetadata(appname: *const c.char, appversion: *const c.char, appidentifier: *const c.char): sdl.SDLError? {
    if !raw.SDL_SetAppMetadata(appname, appversion, appidentifier) {
        return sdl.last_error("SetAppMetadata failed")
    }
    return null
}

fn SetAppMetadataProperty(name: *const c.char, value: *const c.char): sdl.SDLError? {
    if !raw.SDL_SetAppMetadataProperty(name, value) {
        return sdl.last_error("SetAppMetadataProperty failed")
    }
    return null
}

fn GetAppMetadataProperty(name: *const c.char): *const c.char {
    return raw.SDL_GetAppMetadataProperty(name)
}
