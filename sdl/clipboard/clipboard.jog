// Idiomatic v2 wrappers for SDL clipboard (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn SetClipboardText(text: *byte): i32 {
    return SDL_SetClipboardText(text)
}

fn GetClipboardText(): *byte {
    return SDL_GetClipboardText()
}

fn HasClipboardText(): i32 {
    return SDL_HasClipboardText()
}

fn SetPrimarySelectionText(text: *byte): i32 {
    return SDL_SetPrimarySelectionText(text)
}

fn GetPrimarySelectionText(): *byte {
    return SDL_GetPrimarySelectionText()
}

fn HasPrimarySelectionText(): i32 {
    return SDL_HasPrimarySelectionText()
}

fn ClearClipboardData(): i32 {
    return SDL_ClearClipboardData()
}

fn GetClipboardData(mime_type: *byte, size: *byte): *byte {
    return SDL_GetClipboardData(mime_type, size)
}

fn HasClipboardData(mime_type: *byte): i32 {
    return SDL_HasClipboardData(mime_type)
}

fn GetClipboardMimeTypes(num_mime_types: *byte): **byte {
    return SDL_GetClipboardMimeTypes(num_mime_types)
}

fn SetClipboardData(callback: *byte, cleanup: *byte, userdata: *byte, mime_types: **byte, num_mime_types: u64): i32 {
    return SDL_SetClipboardData(callback, cleanup, userdata, mime_types, num_mime_types)
}

