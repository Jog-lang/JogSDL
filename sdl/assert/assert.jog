// Idiomatic v2 wrappers for SDL assert (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetAssertionReport(): *byte {
    return SDL_GetAssertionReport()
}

fn ResetAssertionReport() {
    SDL_ResetAssertionReport()
}

fn GetAssertionHandler(puserdata: **byte): *byte {
    return SDL_GetAssertionHandler(puserdata)
}

fn GetDefaultAssertionHandler(): *byte {
    return SDL_GetDefaultAssertionHandler()
}

fn SetAssertionHandler(handler: *byte, userdata: *byte): i32 {
    return SDL_SetAssertionHandler(handler, userdata)
}

