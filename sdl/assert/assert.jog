// Idiomatic wrappers over sdl3.assert.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.assert as raw

fn SetAssertionHandler(handler: *void, userdata: *void) {
    raw.SDL_SetAssertionHandler(handler, userdata)
}

fn GetDefaultAssertionHandler(): *void {
    return raw.SDL_GetDefaultAssertionHandler()
}

fn GetAssertionHandler(puserdata: **void): *void {
    return raw.SDL_GetAssertionHandler(puserdata)
}

fn GetAssertionReport(): *const void {
    return raw.SDL_GetAssertionReport()
}

fn ResetAssertionReport() {
    raw.SDL_ResetAssertionReport()
}
