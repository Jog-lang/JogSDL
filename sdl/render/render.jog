// Renderer / texture wrappers (v2 flat merge).

/// Opaque renderer handle.
struct Renderer {
    private ptr: *byte
}

/// Opaque texture handle with logical size.
struct Texture {
    private ptr: *byte
    w: i32
    h: i32
}

/// Integer rectangle for texture update/lock (matches SDL_Rect layout: x,y,w,h).
struct Rect {
    x: i32
    y: i32
    w: i32
    h: i32
}

/// Float rectangle for fill/draw calls (matches SDL_FRect layout: x,y,w,h).
struct FRect {
    x: f32
    y: f32
    w: f32
    h: f32
}

/// RGBA8 draw color (matches SDL_Color field order).
struct Color {
    r: u8
    g: u8
    b: u8
    a: u8
}

/// Build an integer Rect.
fn rect(x: i32, y: i32, w: i32, h: i32): Rect {
    return Rect(x: x, y: y, w: w, h: h)
}

/// Build an FRect.
fn frect(x: f32, y: f32, w: f32, h: f32): FRect {
    return FRect(x: x, y: y, w: w, h: h)
}

/// Build a Color.
fn color(r: u8, g: u8, b: u8, a: u8): Color {
    return Color(r: r, g: g, b: b, a: a)
}

/// True when the underlying SDL renderer pointer is non-null.
fn Renderer.ok(): bool {
    return self.ptr != null
}

/// Escape hatch for Friction wasm tick loops that stash opaque pointers.
fn Renderer.raw_ptr(): *byte {
    return self.ptr
}

/**
 * Destroy this renderer.
 * Safe to call when the handle is empty (null ptr).
 * @see https://wiki.libsdl.org/SDL3/SDL_DestroyRenderer
 */
fn Renderer.destroy() {
    if (self.ptr != null) {
        SDL_DestroyRenderer(self.ptr)
    }
}

/**
 * Set the color used for drawing operations (clear, fill, lines, …).
 * @param c RGBA channels 0–255
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_SetRenderDrawColor
 */
fn Renderer.set_draw_color(c: Color): SDLError? {
    if (SDL_SetRenderDrawColor(self.ptr, c.r, c.g, c.b, c.a) == 0) {
        return last_error("SetRenderDrawColor failed")
    }
    return null
}

/**
 * Clear the current render target with the current draw color.
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderClear
 */
fn Renderer.clear(): SDLError? {
    if (SDL_RenderClear(self.ptr) == 0) {
        return last_error("RenderClear failed")
    }
    return null
}

/**
 * Update the screen with any rendering performed since the previous present.
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderPresent
 */
fn Renderer.present(): SDLError? {
    if (SDL_RenderPresent(self.ptr) == 0) {
        return last_error("RenderPresent failed")
    }
    return null
}

/**
 * Fill a rectangle on the current render target with the draw color.
 * `rect` is taken by value; address is passed to SDL for the call duration.
 * @param rect area in render-target coordinates (subpixel)
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderFillRect
 */
fn Renderer.fill_rect(rect: FRect): SDLError? {
    if (SDL_RenderFillRect(self.ptr, &rect) == 0) {
        return last_error("RenderFillRect failed")
    }
    return null
}

/**
 * Create an ARGB8888 texture with the given SDL_TextureAccess mode.
 * @param w width in pixels
 * @param h height in pixels
 * @param access TEXTUREACCESS_STATIC / STREAMING / TARGET
 * @return (Texture, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateTexture
 */
fn Renderer.create_texture(w: i32, h: i32, access: i32): (Texture, SDLError?) {
    val p = SDL_CreateTexture(self.ptr, PIXELFORMAT_ARGB8888, access, w, h)
    if (p == null) {
        return (Texture(ptr: null, w: 0, h: 0), last_error("CreateTexture failed"))
    }
    return (Texture(ptr: p, w: w, h: h), null)
}

/**
 * Create a static ARGB8888 texture (rare updates; use `Texture.update` / `update_rect`).
 * @param w width in pixels
 * @param h height in pixels
 * @return (Texture, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateTexture
 */
fn Renderer.create_static_texture(w: i32, h: i32): (Texture, SDLError?) {
    return self.create_texture(w, h, TEXTUREACCESS_STATIC)
}

/**
 * Create a streaming ARGB8888 texture for CPU uploads (`Texture.update` / lock).
 * @param w width in pixels
 * @param h height in pixels
 * @return (Texture, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateTexture
 */
fn Renderer.create_streaming_texture(w: i32, h: i32): (Texture, SDLError?) {
    return self.create_texture(w, h, TEXTUREACCESS_STREAMING)
}

/**
 * Create a texture from an existing CPU surface (copies pixels; surface may be destroyed after).
 * @param surf loaded or created surface
 * @return (Texture, null) on success
 * @see https://wiki.libsdl.org/SDL3/SDL_CreateTextureFromSurface
 */
fn Renderer.create_texture_from_surface(surf: Surface): (Texture, SDLError?) {
    val p = SDL_CreateTextureFromSurface(self.ptr, surf.raw_ptr())
    if (p == null) {
        return (Texture(ptr: null, w: 0, h: 0), last_error("CreateTextureFromSurface failed"))
    }
    return (Texture(ptr: p, w: surf.w, h: surf.h), null)
}

/**
 * Copy the whole texture to the full current render target.
 * @param tex streaming or static texture
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderTexture
 */
fn Renderer.draw_texture(tex: Texture): SDLError? {
    if (SDL_RenderTexture(self.ptr, tex.raw_ptr(), null, null) == 0) {
        return last_error("RenderTexture failed")
    }
    return null
}

/**
 * Copy a source rectangle of the texture into a destination rectangle on the target.
 * Both rects are taken by value; addresses are passed to SDL for the call duration.
 * @param tex texture to sample
 * @param src region in texture pixels (subpixel FRect)
 * @param dst region on the render target (subpixel FRect)
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderTexture
 */
fn Renderer.draw_texture_rect(tex: Texture, src: FRect, dst: FRect): SDLError? {
    if (SDL_RenderTexture(self.ptr, tex.raw_ptr(), &src, &dst) == 0) {
        return last_error("RenderTexture rect failed")
    }
    return null
}

/// True when the underlying SDL texture pointer is non-null.
fn Texture.ok(): bool {
    return self.ptr != null
}

/// Escape hatch for Friction wasm tick loops that stash opaque pointers.
fn Texture.raw_ptr(): *byte {
    return self.ptr
}

/**
 * Destroy this texture.
 * Safe to call when the handle is empty (null ptr).
 * @see https://wiki.libsdl.org/SDL3/SDL_DestroyTexture
 */
fn Texture.destroy() {
    if (self.ptr != null) {
        SDL_DestroyTexture(self.ptr)
    }
}

/**
 * Upload pixel bytes for the entire texture (pitch = width × 4 for ARGB8888).
 * Caller retains ownership of `pixels`; buffer must stay live for the call.
 * @param pixels contiguous pixel bytes (at least w×h×4 for streaming ARGB8888)
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_UpdateTexture
 */
fn Texture.update(pixels: []u8): SDLError? {
    val pitch = self.w * 4
    if (SDL_UpdateTexture(self.ptr, null, pixels.ptr, pitch) == 0) {
        return last_error("UpdateTexture failed")
    }
    return null
}

/**
 * Upload pixel bytes for a sub-rectangle (pitch = rect.w × 4 for ARGB8888).
 * Caller retains ownership of `pixels`; buffer must stay live for the call.
 * @param r destination rectangle in texture pixels
 * @param pixels contiguous rows for `r` (at least r.w×r.h×4)
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_UpdateTexture
 */
fn Texture.update_rect(r: Rect, pixels: []u8): SDLError? {
    val pitch = r.w * 4
    if (SDL_UpdateTexture(self.ptr, &r, pixels.ptr, pitch) == 0) {
        return last_error("UpdateTexture rect failed")
    }
    return null
}

/**
 * Multiply RGB when drawing this texture (0–255 per channel).
 * @see https://wiki.libsdl.org/SDL3/SDL_SetTextureColorMod
 */
fn Texture.set_color_mod(r: u8, g: u8, b: u8): SDLError? {
    if (SDL_SetTextureColorMod(self.ptr, r, g, b) == 0) {
        return last_error("SetTextureColorMod failed")
    }
    return null
}

/**
 * Set per-texture alpha mod (0–255).
 * @see https://wiki.libsdl.org/SDL3/SDL_SetTextureAlphaMod
 */
fn Texture.set_alpha_mod(a: u8): SDLError? {
    if (SDL_SetTextureAlphaMod(self.ptr, a) == 0) {
        return last_error("SetTextureAlphaMod failed")
    }
    return null
}

/**
 * Unlock a previously locked streaming texture (applies writes).
 * Prefer `Texture.update` / `update_rect` until LockTexture KEEP lands (Friction: void** out).
 * @see https://wiki.libsdl.org/SDL3/SDL_UnlockTexture
 */
fn Texture.unlock() {
    if (self.ptr != null) {
        SDL_UnlockTexture(self.ptr)
    }
}

// --- Friction escape hatches (wasm tick / no per-frame handle returns) ---
// See JogDocs bootstrap/Friction: struct returns bump-alloc OOM on hot paths.
// Prefer Renderer/Texture methods when handles stay on the stack.

/**
 * Update texture from an opaque pointer (Friction / wasm).
 * Prefer `Texture.update` on native stacks.
 * @param tex opaque SDL_Texture*
 * @param pixels pixel bytes
 * @param pitch bytes per row
 * @return null on success
 * @see https://wiki.libsdl.org/SDL3/SDL_UpdateTexture
 */
fn UpdateTextureRaw(tex: *byte, pixels: *byte, pitch: i32): SDLError? {
    if (SDL_UpdateTexture(tex, null, pixels, pitch) == 0) {
        return last_error("UpdateTextureRaw failed")
    }
    return null
}

/**
 * Draw texture from opaque pointers (Friction / wasm).
 * Prefer `Renderer.draw_texture` on native stacks.
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderTexture
 */
fn DrawTextureRaw(ren: *byte, tex: *byte): SDLError? {
    if (SDL_RenderTexture(ren, tex, null, null) == 0) {
        return last_error("DrawTextureRaw failed")
    }
    return null
}

/**
 * Set draw color from an opaque renderer pointer (Friction / wasm).
 * Prefer `Renderer.set_draw_color(Color)` on native stacks.
 * @see https://wiki.libsdl.org/SDL3/SDL_SetRenderDrawColor
 */
fn SetDrawColorRaw(ren: *byte, r: u8, g: u8, b: u8, a: u8): SDLError? {
    if (SDL_SetRenderDrawColor(ren, r, g, b, a) == 0) {
        return last_error("SetDrawColorRaw failed")
    }
    return null
}

/**
 * Clear from an opaque renderer pointer (Friction / wasm).
 * Prefer `Renderer.clear` on native stacks.
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderClear
 */
fn ClearRaw(ren: *byte): SDLError? {
    if (SDL_RenderClear(ren) == 0) {
        return last_error("ClearRaw failed")
    }
    return null
}

/**
 * Present from an opaque renderer pointer (Friction / wasm).
 * Prefer `Renderer.present` on native stacks.
 * @see https://wiki.libsdl.org/SDL3/SDL_RenderPresent
 */
fn PresentRaw(ren: *byte): SDLError? {
    if (SDL_RenderPresent(ren) == 0) {
        return last_error("PresentRaw failed")
    }
    return null
}
