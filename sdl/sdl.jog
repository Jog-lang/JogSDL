// Jog-facing SDL3 API. Raw @link / SDL_* live in unexported package sdl3.
import sdl3
import std.c
import std.mem
import std.text

val INIT_VIDEO: u32 = 0x00000020
val EVENT_QUIT: u32 = 0x100
// SDL3: window-manager close is WINDOW_CLOSE_REQUESTED (0x210); QUIT follows after destroy.
val EVENT_WINDOW_CLOSE_REQUESTED: u32 = 0x210
val EVENT_KEY_DOWN: u32 = 0x300
val EVENT_KEY_UP: u32 = 0x301
val WINDOW_RESIZABLE: u64 = 0x0000000000000020

// Scancodes used by the raycaster / smoke apps (SDL_scancode.h).
val SCANCODE_A: u32 = 4
val SCANCODE_D: u32 = 7
val SCANCODE_S: u32 = 22
val SCANCODE_W: u32 = 26
val SCANCODE_ESCAPE: u32 = 41
val SCANCODE_RIGHT: u32 = 79
val SCANCODE_LEFT: u32 = 80

// SDL_PIXELFORMAT_ARGB8888 — pack pixels as 0xAARRGGBB in a native u32.
val PIXELFORMAT_ARGB8888: u32 = 0x16362004
val TEXTUREACCESS_STREAMING: i32 = 1

// Concrete error with a message. Callers use if err != null and err!!.message().
struct SDLError {
    msg: str
}

fn SDLError.message(): str {
    return self.msg
}

private fn last_error(fallback: str): SDLError {
    val p = sdl3.SDL_GetError()
    val viewed = c.fromCStr(p)
    var e: SDLError
    if viewed.len > 0 {
        e.msg = c.copyCStr(p)
    } else {
        e.msg = fallback
    }
    return e
}

/**
 * Initializes the SDL library.
 * @param flags: Init flags such as INIT_VIDEO.
 * @return: An error if initialization failed.
 */
fn Init(flags: u32): SDLError? {
    if !sdl3.SDL_Init(flags) {
        return last_error("Init failed")
    }
    return null
}

fn Quit() {
    sdl3.SDL_Quit()
}

// ptr is optional so a failed create can return a zero Window (Errors.md).
struct Window {
    ptr: *sdl3.SDL_Window?
}

struct Renderer {
    ptr: *sdl3.SDL_Renderer?
}

struct Texture {
    ptr: *sdl3.SDL_Texture?
    w: i32
    h: i32
}

struct Event {
    kind: u32
    scancode: u32
}

struct FRect {
    x: f32
    y: f32
    w: f32
    h: f32
}

fn frect(x: f32, y: f32, w: f32, h: f32): FRect {
    var r: FRect
    r.x = x
    r.y = y
    r.w = w
    r.h = h
    return r
}

private fn empty_window(): Window {
    var win: Window
    return win
}

private fn empty_renderer(): Renderer {
    var ren: Renderer
    return ren
}

private fn empty_texture(): Texture {
    var tex: Texture
    return tex
}

/**
 * Creates a window. title is a Jog str; C conversion stays inside this package.
 * @return: (window, null) on success, or (zero window, error) on failure.
 */
fn CreateWindow(title: str, w: i32, h: i32, flags: u64): (Window, SDLError?) {
    with (mem.heap()) {
        val ctitle = title.cstr()
        defer text.free_cstr(ctitle, title.len)
        val ptr = sdl3.SDL_CreateWindow(ctitle, w as c.int, h as c.int, flags)
        if ptr == null {
            return empty_window(), last_error("CreateWindow failed")
        }
        var win: Window
        win.ptr = ptr
        return win, null
    }
}

/**
 * Creates a window and a default renderer in one call.
 */
fn CreateWindowAndRenderer(title: str, w: i32, h: i32, flags: u64): (Window, Renderer, SDLError?) {
    with (mem.heap()) {
        val ctitle = title.cstr()
        defer text.free_cstr(ctitle, title.len)
        var win_raw: *sdl3.SDL_Window? = null
        var ren_raw: *sdl3.SDL_Renderer? = null
        if !sdl3.SDL_CreateWindowAndRenderer(
            ctitle,
            w as c.int,
            h as c.int,
            flags,
            &win_raw as **sdl3.SDL_Window,
            &ren_raw as **sdl3.SDL_Renderer
        ) {
            return empty_window(), empty_renderer(), last_error("CreateWindowAndRenderer failed")
        }
        var win: Window
        win.ptr = win_raw
        var ren: Renderer
        ren.ptr = ren_raw
        return win, ren, null
    }
}

fn Window.destroy() {
    if self.ptr != null {
        sdl3.SDL_DestroyWindow(self.ptr!!)
    }
}

/**
 * Creates a default renderer for this window (SDL driver name null).
 */
fn Window.create_renderer(): (Renderer, SDLError?) {
    if self.ptr == null {
        var e: SDLError
        e.msg = "CreateRenderer: null window"
        return empty_renderer(), e
    }
    val ptr = sdl3.SDL_CreateRenderer(self.ptr!!, null)
    if ptr == null {
        return empty_renderer(), last_error("CreateRenderer failed")
    }
    var ren: Renderer
    ren.ptr = ptr
    return ren, null
}

fn Renderer.destroy() {
    if self.ptr != null {
        sdl3.SDL_DestroyRenderer(self.ptr!!)
    }
}

fn Renderer.set_draw_color(r: u8, g: u8, b: u8, a: u8): SDLError? {
    if self.ptr == null {
        return last_error("SetRenderDrawColor: null renderer")
    }
    if !sdl3.SDL_SetRenderDrawColor(self.ptr!!, r, g, b, a) {
        return last_error("SetRenderDrawColor failed")
    }
    return null
}

fn Renderer.clear(): SDLError? {
    if self.ptr == null {
        return last_error("RenderClear: null renderer")
    }
    if !sdl3.SDL_RenderClear(self.ptr!!) {
        return last_error("RenderClear failed")
    }
    return null
}

fn Renderer.fill_rect(rect: FRect): SDLError? {
    if self.ptr == null {
        return last_error("RenderFillRect: null renderer")
    }
    if !sdl3.SDL_RenderFillRect(self.ptr!!, &rect as *const sdl3.SDL_FRect) {
        return last_error("RenderFillRect failed")
    }
    return null
}

fn Renderer.present(): SDLError? {
    if self.ptr == null {
        return last_error("RenderPresent: null renderer")
    }
    if !sdl3.SDL_RenderPresent(self.ptr!!) {
        return last_error("RenderPresent failed")
    }
    return null
}

/**
 * Creates an ARGB8888 streaming texture for software framebuffer blits.
 */
fn Renderer.create_streaming_texture(w: i32, h: i32): (Texture, SDLError?) {
    if self.ptr == null {
        var e: SDLError
        e.msg = "CreateTexture: null renderer"
        return empty_texture(), e
    }
    val ptr = sdl3.SDL_CreateTexture(
        self.ptr!!,
        PIXELFORMAT_ARGB8888,
        TEXTUREACCESS_STREAMING as c.int,
        w as c.int,
        h as c.int
    )
    if ptr == null {
        return empty_texture(), last_error("CreateTexture failed")
    }
    var tex: Texture
    tex.ptr = ptr
    tex.w = w
    tex.h = h
    return tex, null
}

/**
 * Draws the full texture to the full render target (null src/dst rects).
 */
fn Renderer.draw_texture(tex: Texture): SDLError? {
    if self.ptr == null {
        return last_error("RenderTexture: null renderer")
    }
    if tex.ptr == null {
        return last_error("RenderTexture: null texture")
    }
    if !sdl3.SDL_RenderTexture(self.ptr!!, tex.ptr!!, null, null) {
        return last_error("RenderTexture failed")
    }
    return null
}

fn Texture.destroy() {
    if self.ptr != null {
        sdl3.SDL_DestroyTexture(self.ptr!!)
    }
}

/**
 * Uploads a tightly packed ARGB8888 pixel buffer (pitch = w * 4).
 * pixels is the first byte of a contiguous framebuffer.
 */
fn Texture.update(pixels: *const void): SDLError? {
    if self.ptr == null {
        return last_error("UpdateTexture: null texture")
    }
    val pitch = self.w * 4
    if !sdl3.SDL_UpdateTexture(self.ptr!!, null, pixels, pitch as c.int) {
        return last_error("UpdateTexture failed")
    }
    return null
}

/**
 * Polls one event. Returns (event, true) when an event was available.
 * Key events expose scancode; other kinds leave scancode at 0.
 */
fn PollEvent(): (Event, bool) {
    var raw = sdl3.zero_event()
    if !sdl3.SDL_PollEvent(&raw) {
        var empty: Event
        return empty, false
    }
    var ev: Event
    ev.kind = raw.event_type
    if raw.event_type == EVENT_KEY_DOWN || raw.event_type == EVENT_KEY_UP {
        ev.scancode = raw.scancode
    }
    return ev, true
}

/**
 * True when the physical key for scancode is currently held.
 * Calls SDL_GetKeyboardState (snapshot updated by PollEvent / pump).
 */
fn KeyboardIsDown(scancode: u32): bool {
    var n: c.int = 0
    val state = sdl3.SDL_GetKeyboardState(&n)
    if scancode as c.int >= n {
        return false
    }
    return *(state + (scancode as usize)) != 0
}

fn Delay(ms: u32) {
    sdl3.SDL_Delay(ms)
}

/** Milliseconds since SDL init. */
fn GetTicks(): u64 {
    return sdl3.SDL_GetTicks()
}
