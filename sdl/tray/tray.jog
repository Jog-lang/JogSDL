// Idiomatic v2 wrappers for SDL tray (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn CreateTray(icon: *byte, tooltip: *byte): *byte {
    return SDL_CreateTray(icon, tooltip)
}

fn SetTrayIcon(tray: *byte, icon: *byte) {
    SDL_SetTrayIcon(tray, icon)
}

fn SetTrayTooltip(tray: *byte, tooltip: *byte) {
    SDL_SetTrayTooltip(tray, tooltip)
}

fn CreateTrayMenu(tray: *byte): *byte {
    return SDL_CreateTrayMenu(tray)
}

fn CreateTraySubmenu(entry: *byte): *byte {
    return SDL_CreateTraySubmenu(entry)
}

fn GetTrayMenu(tray: *byte): *byte {
    return SDL_GetTrayMenu(tray)
}

fn GetTraySubmenu(entry: *byte): *byte {
    return SDL_GetTraySubmenu(entry)
}

fn GetTrayEntries(menu: *byte, count: *byte): **byte {
    return SDL_GetTrayEntries(menu, count)
}

fn RemoveTrayEntry(entry: *byte) {
    SDL_RemoveTrayEntry(entry)
}

fn SetTrayEntryLabel(entry: *byte, label: *byte) {
    SDL_SetTrayEntryLabel(entry, label)
}

fn GetTrayEntryLabel(entry: *byte): *byte {
    return SDL_GetTrayEntryLabel(entry)
}

fn SetTrayEntryChecked(entry: *byte, checked: i32) {
    SDL_SetTrayEntryChecked(entry, checked)
}

fn GetTrayEntryChecked(entry: *byte): i32 {
    return SDL_GetTrayEntryChecked(entry)
}

fn SetTrayEntryEnabled(entry: *byte, enabled: i32) {
    SDL_SetTrayEntryEnabled(entry, enabled)
}

fn GetTrayEntryEnabled(entry: *byte): i32 {
    return SDL_GetTrayEntryEnabled(entry)
}

fn ClickTrayEntry(entry: *byte) {
    SDL_ClickTrayEntry(entry)
}

fn DestroyTray(tray: *byte) {
    SDL_DestroyTray(tray)
}

fn GetTrayEntryParent(entry: *byte): *byte {
    return SDL_GetTrayEntryParent(entry)
}

fn GetTrayMenuParentEntry(menu: *byte): *byte {
    return SDL_GetTrayMenuParentEntry(menu)
}

fn GetTrayMenuParentTray(menu: *byte): *byte {
    return SDL_GetTrayMenuParentTray(menu)
}

fn UpdateTrays() {
    SDL_UpdateTrays()
}

fn SetTrayEntryCallback(entry: *byte, callback: *byte, userdata: *byte): i32 {
    return SDL_SetTrayEntryCallback(entry, callback, userdata)
}

