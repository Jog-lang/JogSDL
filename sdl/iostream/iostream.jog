// Idiomatic wrappers over sdl3.iostream.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.iostream as raw
import sdl
import std.c

struct IOStream {
    ptr: *raw.SDL_IOStream?
}

fn empty_iostream(): IOStream {
    var h: IOStream
    return h
}

fn IOFromFile(file: *const c.char, mode: *const c.char): *raw.SDL_IOStream {
    return raw.SDL_IOFromFile(file, mode)
}

fn IOFromMem(mem: *void, size: c.size_t): *raw.SDL_IOStream {
    return raw.SDL_IOFromMem(mem, size)
}

fn IOFromConstMem(mem: *const void, size: c.size_t): *raw.SDL_IOStream {
    return raw.SDL_IOFromConstMem(mem, size)
}

fn IOFromDynamicMem(): *raw.SDL_IOStream {
    return raw.SDL_IOFromDynamicMem()
}

fn OpenIO(iface: *const void, userdata: *void): *raw.SDL_IOStream {
    return raw.SDL_OpenIO(iface, userdata)
}

fn CloseIO(context_: *raw.SDL_IOStream): sdl.SDLError? {
    if !raw.SDL_CloseIO(context_) {
        return sdl.last_error("CloseIO failed")
    }
    return null
}

fn GetIOProperties(context_: *raw.SDL_IOStream): u32 {
    return raw.SDL_GetIOProperties(context_)
}

fn GetIOStatus(context_: *raw.SDL_IOStream): u32 {
    return raw.SDL_GetIOStatus(context_)
}

fn GetIOSize(context_: *raw.SDL_IOStream): i64 {
    return raw.SDL_GetIOSize(context_)
}

fn SeekIO(context_: *raw.SDL_IOStream, offset: i64, whence: u32): i64 {
    return raw.SDL_SeekIO(context_, offset, whence)
}

fn TellIO(context_: *raw.SDL_IOStream): i64 {
    return raw.SDL_TellIO(context_)
}

fn ReadIO(context_: *raw.SDL_IOStream, ptr: *void, size: c.size_t): c.size_t {
    return raw.SDL_ReadIO(context_, ptr, size)
}

fn WriteIO(context_: *raw.SDL_IOStream, ptr: *const void, size: c.size_t): c.size_t {
    return raw.SDL_WriteIO(context_, ptr, size)
}

fn FlushIO(context_: *raw.SDL_IOStream): sdl.SDLError? {
    if !raw.SDL_FlushIO(context_) {
        return sdl.last_error("FlushIO failed")
    }
    return null
}

fn LoadFile_IO(src: *raw.SDL_IOStream, datasize: *c.size_t, closeio: bool): *void {
    return raw.SDL_LoadFile_IO(src, datasize, closeio)
}

fn LoadFile(file: *const c.char, datasize: *c.size_t): *void {
    return raw.SDL_LoadFile(file, datasize)
}

fn SaveFile_IO(src: *raw.SDL_IOStream, data: *const void, datasize: c.size_t, closeio: bool): sdl.SDLError? {
    if !raw.SDL_SaveFile_IO(src, data, datasize, closeio) {
        return sdl.last_error("SaveFile_IO failed")
    }
    return null
}

fn SaveFile(file: *const c.char, data: *const void, datasize: c.size_t): sdl.SDLError? {
    if !raw.SDL_SaveFile(file, data, datasize) {
        return sdl.last_error("SaveFile failed")
    }
    return null
}

