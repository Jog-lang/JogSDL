// Idiomatic wrappers over sdl3.mouse.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.mouse as raw
import sdl3.surface
import sdl3.video
import sdl
import std.c

struct Cursor {
    ptr: *raw.SDL_Cursor?
}

fn empty_cursor(): Cursor {
    var h: Cursor
    return h
}

fn GetRelativeMouseState(x: *f32, y: *f32): u32 {
    return raw.SDL_GetRelativeMouseState(x, y)
}

fn HasMouse(): sdl.SDLError? {
    if !raw.SDL_HasMouse() {
        return sdl.last_error("HasMouse failed")
    }
    return null
}

fn GetMice(count: *c.int): *u32 {
    return raw.SDL_GetMice(count)
}

fn GetMouseNameForID(instance_id: u32): *const c.char {
    return raw.SDL_GetMouseNameForID(instance_id)
}

fn GetMouseFocus(): *video.SDL_Window {
    return raw.SDL_GetMouseFocus()
}

fn WarpMouseInWindow(window: *video.SDL_Window, x: f32, y: f32) {
    raw.SDL_WarpMouseInWindow(window, x, y)
}

fn WarpMouseGlobal(x: f32, y: f32): sdl.SDLError? {
    if !raw.SDL_WarpMouseGlobal(x, y) {
        return sdl.last_error("WarpMouseGlobal failed")
    }
    return null
}

fn SetRelativeMouseTransform(callback: *void, userdata: *void): sdl.SDLError? {
    if !raw.SDL_SetRelativeMouseTransform(callback, userdata) {
        return sdl.last_error("SetRelativeMouseTransform failed")
    }
    return null
}

fn SetWindowRelativeMouseMode(window: *video.SDL_Window, enabled: bool): sdl.SDLError? {
    if !raw.SDL_SetWindowRelativeMouseMode(window, enabled) {
        return sdl.last_error("SetWindowRelativeMouseMode failed")
    }
    return null
}

fn GetWindowRelativeMouseMode(window: *video.SDL_Window): sdl.SDLError? {
    if !raw.SDL_GetWindowRelativeMouseMode(window) {
        return sdl.last_error("GetWindowRelativeMouseMode failed")
    }
    return null
}

fn CaptureMouse(enabled: bool): sdl.SDLError? {
    if !raw.SDL_CaptureMouse(enabled) {
        return sdl.last_error("CaptureMouse failed")
    }
    return null
}

fn CreateCursor(data: *const u8, mask: *const u8, w: c.int, h: c.int, hot_x: c.int, hot_y: c.int): *raw.SDL_Cursor {
    return raw.SDL_CreateCursor(data, mask, w, h, hot_x, hot_y)
}

fn CreateColorCursor(surface: *surface.SDL_Surface, hot_x: c.int, hot_y: c.int): *raw.SDL_Cursor {
    return raw.SDL_CreateColorCursor(surface, hot_x, hot_y)
}

fn SetCursor(cursor: *raw.SDL_Cursor): sdl.SDLError? {
    if !raw.SDL_SetCursor(cursor) {
        return sdl.last_error("SetCursor failed")
    }
    return null
}

fn GetCursor(): *raw.SDL_Cursor {
    return raw.SDL_GetCursor()
}

fn GetDefaultCursor(): *raw.SDL_Cursor {
    return raw.SDL_GetDefaultCursor()
}

fn Cursor.destroy() {
    if self.ptr != null {
        raw.SDL_DestroyCursor(self.ptr!!)
    }
}

fn ShowCursor(): sdl.SDLError? {
    if !raw.SDL_ShowCursor() {
        return sdl.last_error("ShowCursor failed")
    }
    return null
}

fn HideCursor(): sdl.SDLError? {
    if !raw.SDL_HideCursor() {
        return sdl.last_error("HideCursor failed")
    }
    return null
}

fn CursorVisible(): sdl.SDLError? {
    if !raw.SDL_CursorVisible() {
        return sdl.last_error("CursorVisible failed")
    }
    return null
}
