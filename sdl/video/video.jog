// Idiomatic wrappers over sdl3.video.
// Variadic / unexpressible C entry points are omitted — see JogDocs Friction.
import sdl3.video as raw
import sdl3.rect
import sdl3.surface
import sdl
import std.c

struct Window {
    ptr: *raw.SDL_Window?
}

fn empty_window(): Window {
    var h: Window
    return h
}

struct Renderer {
    ptr: *raw.SDL_Renderer?
}

fn empty_renderer(): Renderer {
    var h: Renderer
    return h
}

fn GetNumVideoDrivers(): c.int {
    return raw.SDL_GetNumVideoDrivers()
}

fn GetVideoDriver(index: c.int): *const c.char {
    return raw.SDL_GetVideoDriver(index)
}

fn GetCurrentVideoDriver(): *const c.char {
    return raw.SDL_GetCurrentVideoDriver()
}

fn GetSystemTheme(): u32 {
    return raw.SDL_GetSystemTheme()
}

fn GetDisplays(count: *c.int): *u32 {
    return raw.SDL_GetDisplays(count)
}

fn GetPrimaryDisplay(): u32 {
    return raw.SDL_GetPrimaryDisplay()
}

fn GetDisplayProperties(displayID: u32): u32 {
    return raw.SDL_GetDisplayProperties(displayID)
}

fn GetDisplayName(displayID: u32): *const c.char {
    return raw.SDL_GetDisplayName(displayID)
}

fn GetDisplayBounds(displayID: u32, rect: *rect.SDL_Rect): sdl.SDLError? {
    if !raw.SDL_GetDisplayBounds(displayID, rect) {
        return sdl.last_error("GetDisplayBounds failed")
    }
    return null
}

