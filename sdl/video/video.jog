}

fn GetClosestFullscreenDisplayMode(displayID: u32, w: c.int, h: c.int, refresh_rate: f32, include_high_density_modes: bool, closest: *void): sdl.SDLError? {
    if !raw.SDL_GetClosestFullscreenDisplayMode(displayID, w, h, refresh_rate, include_high_density_modes, closest) {
        return sdl.last_error("GetClosestFullscreenDisplayMode failed")
    }
    return null
}

