fn CreateWindow(title: *const c.char, w: c.int, h: c.int, flags: u64): (Window, sdl.SDLError?) {
    val ptr = raw.SDL_CreateWindow(title, w, h, flags)
    if ptr == null {
        return empty_window(), sdl.last_error("CreateWindow failed")
    }
    var h: Window
    h.ptr = ptr
    return h, null
}

fn CreatePopupWindow(parent: *raw.SDL_Window, offset_x: c.int, offset_y: c.int, w: c.int, h: c.int, flags: u64): *raw.SDL_Window {
    return raw.SDL_CreatePopupWindow(parent, offset_x, offset_y, w, h, flags)
}

