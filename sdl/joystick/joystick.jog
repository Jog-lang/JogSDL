fn SetJoystickLED(joystick: *raw.SDL_Joystick, red: u8, green: u8, blue: u8): sdl.SDLError? {
    if !raw.SDL_SetJoystickLED(joystick, red, green, blue) {
        return sdl.last_error("SetJoystickLED failed")
    }
    return null
