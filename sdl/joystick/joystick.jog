fn CloseJoystick(joystick: *raw.SDL_Joystick) {
    raw.SDL_CloseJoystick(joystick)
}

fn GetJoystickPowerInfo(joystick: *raw.SDL_Joystick, percent: *c.int): u32 {
    return raw.SDL_GetJoystickPowerInfo(joystick, percent)
}
