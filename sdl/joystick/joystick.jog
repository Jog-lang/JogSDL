fn SendJoystickEffect(joystick: *raw.SDL_Joystick, data: *const void, size: c.int): sdl.SDLError? {
    if !raw.SDL_SendJoystickEffect(joystick, data, size) {
        return sdl.last_error("SendJoystickEffect failed")
