// Idiomatic v2 wrappers for SDL joystick (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn LockJoysticks() {
    SDL_LockJoysticks()
}

fn UnlockJoysticks() {
    SDL_UnlockJoysticks()
}

fn HasJoystick(): i32 {
    return SDL_HasJoystick()
}

fn GetJoysticks(count: *byte): *byte {
    return SDL_GetJoysticks(count)
}

fn GetJoystickNameForID(instance_id: u32): *byte {
    return SDL_GetJoystickNameForID(instance_id)
}

fn GetJoystickPathForID(instance_id: u32): *byte {
    return SDL_GetJoystickPathForID(instance_id)
}

fn GetJoystickPlayerIndexForID(instance_id: u32): i32 {
    return SDL_GetJoystickPlayerIndexForID(instance_id)
}

fn GetJoystickVendorForID(instance_id: u32): u16 {
    return SDL_GetJoystickVendorForID(instance_id)
}

fn GetJoystickProductForID(instance_id: u32): u16 {
    return SDL_GetJoystickProductForID(instance_id)
}

fn GetJoystickProductVersionForID(instance_id: u32): u16 {
    return SDL_GetJoystickProductVersionForID(instance_id)
}

fn OpenJoystick(instance_id: u32): *byte {
    return SDL_OpenJoystick(instance_id)
}

fn GetJoystickFromID(instance_id: u32): *byte {
    return SDL_GetJoystickFromID(instance_id)
}

fn GetJoystickFromPlayerIndex(player_index: i32): *byte {
    return SDL_GetJoystickFromPlayerIndex(player_index)
}

fn AttachVirtualJoystick(desc: *byte): u32 {
    return SDL_AttachVirtualJoystick(desc)
}

fn DetachVirtualJoystick(instance_id: u32): i32 {
    return SDL_DetachVirtualJoystick(instance_id)
}

fn IsJoystickVirtual(instance_id: u32): i32 {
    return SDL_IsJoystickVirtual(instance_id)
}

fn SetJoystickVirtualAxis(joystick: *byte, axis: i32, value: i16): i32 {
    return SDL_SetJoystickVirtualAxis(joystick, axis, value)
}

fn SetJoystickVirtualBall(joystick: *byte, ball: i32, xrel: i16, yrel: i16): i32 {
    return SDL_SetJoystickVirtualBall(joystick, ball, xrel, yrel)
}

fn SetJoystickVirtualButton(joystick: *byte, button: i32, down: i32): i32 {
    return SDL_SetJoystickVirtualButton(joystick, button, down)
}

fn SetJoystickVirtualHat(joystick: *byte, hat: i32, value: u8): i32 {
    return SDL_SetJoystickVirtualHat(joystick, hat, value)
}

fn SetJoystickVirtualTouchpad(joystick: *byte, touchpad: i32, finger: i32, down: i32, x: f32, y: f32, pressure: f32): i32 {
    return SDL_SetJoystickVirtualTouchpad(joystick, touchpad, finger, down, x, y, pressure)
}

fn GetJoystickProperties(joystick: *byte): u32 {
    return SDL_GetJoystickProperties(joystick)
}

fn GetJoystickName(joystick: *byte): *byte {
    return SDL_GetJoystickName(joystick)
}

fn GetJoystickPath(joystick: *byte): *byte {
    return SDL_GetJoystickPath(joystick)
}

fn GetJoystickPlayerIndex(joystick: *byte): i32 {
    return SDL_GetJoystickPlayerIndex(joystick)
}

fn SetJoystickPlayerIndex(joystick: *byte, player_index: i32): i32 {
    return SDL_SetJoystickPlayerIndex(joystick, player_index)
}

fn GetJoystickVendor(joystick: *byte): u16 {
    return SDL_GetJoystickVendor(joystick)
}

fn GetJoystickProduct(joystick: *byte): u16 {
    return SDL_GetJoystickProduct(joystick)
}

fn GetJoystickProductVersion(joystick: *byte): u16 {
    return SDL_GetJoystickProductVersion(joystick)
}

fn GetJoystickFirmwareVersion(joystick: *byte): u16 {
    return SDL_GetJoystickFirmwareVersion(joystick)
}

fn GetJoystickSerial(joystick: *byte): *byte {
    return SDL_GetJoystickSerial(joystick)
}

fn JoystickConnected(joystick: *byte): i32 {
    return SDL_JoystickConnected(joystick)
}

fn GetJoystickID(joystick: *byte): u32 {
    return SDL_GetJoystickID(joystick)
}

fn GetNumJoystickAxes(joystick: *byte): i32 {
    return SDL_GetNumJoystickAxes(joystick)
}

fn GetNumJoystickBalls(joystick: *byte): i32 {
    return SDL_GetNumJoystickBalls(joystick)
}

fn GetNumJoystickHats(joystick: *byte): i32 {
    return SDL_GetNumJoystickHats(joystick)
}

fn GetNumJoystickButtons(joystick: *byte): i32 {
    return SDL_GetNumJoystickButtons(joystick)
}

fn SetJoystickEventsEnabled(enabled: i32) {
    SDL_SetJoystickEventsEnabled(enabled)
}

fn JoystickEventsEnabled(): i32 {
    return SDL_JoystickEventsEnabled()
}

fn UpdateJoysticks() {
    SDL_UpdateJoysticks()
}

fn GetJoystickAxis(joystick: *byte, axis: i32): i16 {
    return SDL_GetJoystickAxis(joystick, axis)
}

fn GetJoystickAxisInitialState(joystick: *byte, axis: i32, state: *byte): i32 {
    return SDL_GetJoystickAxisInitialState(joystick, axis, state)
}

fn GetJoystickBall(joystick: *byte, ball: i32, dx: *byte, dy: *byte): i32 {
    return SDL_GetJoystickBall(joystick, ball, dx, dy)
}

fn GetJoystickHat(joystick: *byte, hat: i32): u8 {
    return SDL_GetJoystickHat(joystick, hat)
}

fn GetJoystickButton(joystick: *byte, button: i32): i32 {
    return SDL_GetJoystickButton(joystick, button)
}

fn RumbleJoystick(joystick: *byte, low_frequency_rumble: u16, high_frequency_rumble: u16, duration_ms: u32): i32 {
    return SDL_RumbleJoystick(joystick, low_frequency_rumble, high_frequency_rumble, duration_ms)
}

fn RumbleJoystickTriggers(joystick: *byte, left_rumble: u16, right_rumble: u16, duration_ms: u32): i32 {
    return SDL_RumbleJoystickTriggers(joystick, left_rumble, right_rumble, duration_ms)
}

fn SetJoystickLED(joystick: *byte, red: u8, green: u8, blue: u8): i32 {
    return SDL_SetJoystickLED(joystick, red, green, blue)
}

fn SendJoystickEffect(joystick: *byte, data: *byte, size: i32): i32 {
    return SDL_SendJoystickEffect(joystick, data, size)
}

fn CloseJoystick(joystick: *byte) {
    SDL_CloseJoystick(joystick)
}

fn GetJoystickGUID(joystick: *byte): *byte {
    return SDL_GetJoystickGUID(joystick)
}

fn GetJoystickGUIDForID(instance_id: u32): *byte {
    return SDL_GetJoystickGUIDForID(instance_id)
}

fn GetJoystickGUIDInfo(guid: i32, vendor: *byte, product: *byte, version: *byte, crc16: *byte): *byte {
    return SDL_GetJoystickGUIDInfo(guid, vendor, product, version, crc16)
}

fn GetJoystickPowerInfo(joystick: *byte, percent: *byte): *byte {
    return SDL_GetJoystickPowerInfo(joystick, percent)
}

fn GetJoystickType(joystick: *byte): *byte {
    return SDL_GetJoystickType(joystick)
}

fn GetJoystickTypeForID(instance_id: u32): *byte {
    return SDL_GetJoystickTypeForID(instance_id)
}

