// Idiomatic v2 wrappers for SDL log (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn ResetLogPriorities() {
    SDL_ResetLogPriorities()
}

fn GetLogOutputFunction(callback: *byte, userdata: **byte) {
    SDL_GetLogOutputFunction(callback, userdata)
}

fn GetDefaultLogOutputFunction(): *byte {
    return SDL_GetDefaultLogOutputFunction()
}

fn GetLogPriority(category: i32): *byte {
    return SDL_GetLogPriority(category)
}

fn Log(fmt: *byte): i32 {
    return SDL_Log(fmt)
}

fn LogCritical(category: i32, fmt: *byte): i32 {
    return SDL_LogCritical(category, fmt)
}

fn LogDebug(category: i32, fmt: *byte): i32 {
    return SDL_LogDebug(category, fmt)
}

fn LogError(category: i32, fmt: *byte): i32 {
    return SDL_LogError(category, fmt)
}

fn LogInfo(category: i32, fmt: *byte): i32 {
    return SDL_LogInfo(category, fmt)
}

fn LogMessage(category: i32, priority: u32, fmt: *byte): i32 {
    return SDL_LogMessage(category, priority, fmt)
}

fn LogTrace(category: i32, fmt: *byte): i32 {
    return SDL_LogTrace(category, fmt)
}

fn LogVerbose(category: i32, fmt: *byte): i32 {
    return SDL_LogVerbose(category, fmt)
}

fn LogWarn(category: i32, fmt: *byte): i32 {
    return SDL_LogWarn(category, fmt)
}

fn SetLogOutputFunction(callback: *byte, userdata: *byte): i32 {
    return SDL_SetLogOutputFunction(callback, userdata)
}

fn SetLogPriorities(priority: u32): i32 {
    return SDL_SetLogPriorities(priority)
}

fn SetLogPriority(category: i32, priority: u32): i32 {
    return SDL_SetLogPriority(category, priority)
}

fn SetLogPriorityPrefix(priority: u32, prefix: *byte): i32 {
    return SDL_SetLogPriorityPrefix(priority, prefix)
}

