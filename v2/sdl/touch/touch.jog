// Idiomatic v2 wrappers for SDL touch (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetTouchDevices(count: *byte): *byte {
    return SDL_GetTouchDevices(count)
}

fn GetTouchDeviceName(touchID: u64): *byte {
    return SDL_GetTouchDeviceName(touchID)
}

fn GetTouchFingers(touchID: u64, count: *byte): **byte {
    return SDL_GetTouchFingers(touchID, count)
}

