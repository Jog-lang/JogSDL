// Idiomatic v2 wrappers for SDL storage (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn OpenTitleStorage(override: *byte, props: u32): *byte {
    return SDL_OpenTitleStorage(override, props)
}

fn OpenUserStorage(org: *byte, app: *byte, props: u32): *byte {
    return SDL_OpenUserStorage(org, app, props)
}

fn OpenFileStorage(path: *byte): *byte {
    return SDL_OpenFileStorage(path)
}

fn OpenStorage(iface: *byte, userdata: *byte): *byte {
    return SDL_OpenStorage(iface, userdata)
}

fn CloseStorage(storage: *byte): i32 {
    return SDL_CloseStorage(storage)
}

fn StorageReady(storage: *byte): i32 {
    return SDL_StorageReady(storage)
}

fn GetStorageFileSize(storage: *byte, path: *byte, length: *byte): i32 {
    return SDL_GetStorageFileSize(storage, path, length)
}

fn ReadStorageFile(storage: *byte, path: *byte, destination: *byte, length: u64): i32 {
    return SDL_ReadStorageFile(storage, path, destination, length)
}

fn WriteStorageFile(storage: *byte, path: *byte, source: *byte, length: u64): i32 {
    return SDL_WriteStorageFile(storage, path, source, length)
}

fn CreateStorageDirectory(storage: *byte, path: *byte): i32 {
    return SDL_CreateStorageDirectory(storage, path)
}

fn RemoveStoragePath(storage: *byte, path: *byte): i32 {
    return SDL_RemoveStoragePath(storage, path)
}

fn RenameStoragePath(storage: *byte, oldpath: *byte, newpath: *byte): i32 {
    return SDL_RenameStoragePath(storage, oldpath, newpath)
}

fn CopyStorageFile(storage: *byte, oldpath: *byte, newpath: *byte): i32 {
    return SDL_CopyStorageFile(storage, oldpath, newpath)
}

fn GetStoragePathInfo(storage: *byte, path: *byte, info: *byte): i32 {
    return SDL_GetStoragePathInfo(storage, path, info)
}

fn GetStorageSpaceRemaining(storage: *byte): u64 {
    return SDL_GetStorageSpaceRemaining(storage)
}

fn EnumerateStorageDirectory(storage: *byte, path: *byte, callback: *byte, userdata: *byte): i32 {
    return SDL_EnumerateStorageDirectory(storage, path, callback, userdata)
}

