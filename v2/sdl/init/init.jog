// Idiomatic v2 wrappers for SDL init (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn InitSubSystem(flags: u32): i32 {
    return SDL_InitSubSystem(flags)
}

fn QuitSubSystem(flags: u32) {
    SDL_QuitSubSystem(flags)
}

fn WasInit(flags: u32): u32 {
    return SDL_WasInit(flags)
}

fn IsMainThread(): i32 {
    return SDL_IsMainThread()
}

fn SetAppMetadata(appname: *byte, appversion: *byte, appidentifier: *byte): i32 {
    return SDL_SetAppMetadata(appname, appversion, appidentifier)
}

fn SetAppMetadataProperty(name: *byte, value: *byte): i32 {
    return SDL_SetAppMetadataProperty(name, value)
}

fn GetAppMetadataProperty(name: *byte): *byte {
    return SDL_GetAppMetadataProperty(name)
}

fn RunOnMainThread(callback: *byte, userdata: *byte, wait_complete: i32): i32 {
    return SDL_RunOnMainThread(callback, userdata, wait_complete)
}

