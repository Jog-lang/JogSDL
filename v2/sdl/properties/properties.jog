// Idiomatic v2 wrappers for SDL properties (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetGlobalProperties(): u32 {
    return SDL_GetGlobalProperties()
}

fn CreateProperties(): u32 {
    return SDL_CreateProperties()
}

fn CopyProperties(src: u32, dst: u32): i32 {
    return SDL_CopyProperties(src, dst)
}

fn LockProperties(props: u32): i32 {
    return SDL_LockProperties(props)
}

fn UnlockProperties(props: u32) {
    SDL_UnlockProperties(props)
}

fn SetPointerProperty(props: u32, name: *byte, value: *byte): i32 {
    return SDL_SetPointerProperty(props, name, value)
}

fn SetStringProperty(props: u32, name: *byte, value: *byte): i32 {
    return SDL_SetStringProperty(props, name, value)
}

fn SetNumberProperty(props: u32, name: *byte, value: i64): i32 {
    return SDL_SetNumberProperty(props, name, value)
}

fn SetFloatProperty(props: u32, name: *byte, value: f32): i32 {
    return SDL_SetFloatProperty(props, name, value)
}

fn SetBooleanProperty(props: u32, name: *byte, value: i32): i32 {
    return SDL_SetBooleanProperty(props, name, value)
}

fn HasProperty(props: u32, name: *byte): i32 {
    return SDL_HasProperty(props, name)
}

fn GetPointerProperty(props: u32, name: *byte, default_value: *byte): *byte {
    return SDL_GetPointerProperty(props, name, default_value)
}

fn GetStringProperty(props: u32, name: *byte, default_value: *byte): *byte {
    return SDL_GetStringProperty(props, name, default_value)
}

fn GetNumberProperty(props: u32, name: *byte, default_value: i64): i64 {
    return SDL_GetNumberProperty(props, name, default_value)
}

fn GetFloatProperty(props: u32, name: *byte, default_value: f32): f32 {
    return SDL_GetFloatProperty(props, name, default_value)
}

fn GetBooleanProperty(props: u32, name: *byte, default_value: i32): i32 {
    return SDL_GetBooleanProperty(props, name, default_value)
}

fn ClearProperty(props: u32, name: *byte): i32 {
    return SDL_ClearProperty(props, name)
}

fn DestroyProperties(props: u32) {
    SDL_DestroyProperties(props)
}

fn EnumerateProperties(props: u32, callback: *byte, userdata: *byte): i32 {
    return SDL_EnumerateProperties(props, callback, userdata)
}

fn GetPropertyType(props: u32, name: *byte): *byte {
    return SDL_GetPropertyType(props, name)
}

fn SetPointerPropertyWithCleanup(props: u32, name: *byte, value: *byte, cleanup: *byte, userdata: *byte): i32 {
    return SDL_SetPointerPropertyWithCleanup(props, name, value, cleanup, userdata)
}

