// Idiomatic v2 wrappers for SDL keyboard (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn HasKeyboard(): i32 {
    return SDL_HasKeyboard()
}

fn GetKeyboards(count: *byte): *byte {
    return SDL_GetKeyboards(count)
}

fn GetKeyboardNameForID(instance_id: u32): *byte {
    return SDL_GetKeyboardNameForID(instance_id)
}

fn GetKeyboardFocus(): *byte {
    return SDL_GetKeyboardFocus()
}

fn GetKeyboardState(numkeys: *byte): *byte {
    return SDL_GetKeyboardState(numkeys)
}

fn ResetKeyboard() {
    SDL_ResetKeyboard()
}

fn GetModState(): u16 {
    return SDL_GetModState()
}

fn SetModState(modstate: u16) {
    SDL_SetModState(modstate)
}

fn GetKeyFromScancode(scancode: u32, modstate: u16, key_event: i32): u32 {
    return SDL_GetKeyFromScancode(scancode, modstate, key_event)
}

fn GetScancodeFromKey(key: u32, modstate: *byte): u32 {
    return SDL_GetScancodeFromKey(key, modstate)
}

fn SetScancodeName(scancode: u32, name: *byte): i32 {
    return SDL_SetScancodeName(scancode, name)
}

fn GetScancodeName(scancode: u32): *byte {
    return SDL_GetScancodeName(scancode)
}

fn GetScancodeFromName(name: *byte): u32 {
    return SDL_GetScancodeFromName(name)
}

fn GetKeyName(key: u32): *byte {
    return SDL_GetKeyName(key)
}

fn GetKeyFromName(name: *byte): u32 {
    return SDL_GetKeyFromName(name)
}

fn StartTextInput(window: *byte): i32 {
    return SDL_StartTextInput(window)
}

fn StartTextInputWithProperties(window: *byte, props: u32): i32 {
    return SDL_StartTextInputWithProperties(window, props)
}

fn TextInputActive(window: *byte): i32 {
    return SDL_TextInputActive(window)
}

fn StopTextInput(window: *byte): i32 {
    return SDL_StopTextInput(window)
}

fn ClearComposition(window: *byte): i32 {
    return SDL_ClearComposition(window)
}

fn SetTextInputArea(window: *byte, rect: *byte, cursor: i32): i32 {
    return SDL_SetTextInputArea(window, rect, cursor)
}

fn GetTextInputArea(window: *byte, rect: *byte, cursor: *byte): i32 {
    return SDL_GetTextInputArea(window, rect, cursor)
}

fn HasScreenKeyboardSupport(): i32 {
    return SDL_HasScreenKeyboardSupport()
}

fn ScreenKeyboardShown(window: *byte): i32 {
    return SDL_ScreenKeyboardShown(window)
}

