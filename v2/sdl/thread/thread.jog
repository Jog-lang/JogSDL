// Idiomatic v2 wrappers for SDL thread (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn GetThreadName(thread: *byte): *byte {
    return SDL_GetThreadName(thread)
}

fn GetCurrentThreadID(): u64 {
    return SDL_GetCurrentThreadID()
}

fn GetThreadID(thread: *byte): u64 {
    return SDL_GetThreadID(thread)
}

fn WaitThread(thread: *byte, status: *byte) {
    SDL_WaitThread(thread, status)
}

fn DetachThread(thread: *byte) {
    SDL_DetachThread(thread)
}

fn GetTLS(id: *byte): *byte {
    return SDL_GetTLS(id)
}

fn CleanupTLS() {
    SDL_CleanupTLS()
}

fn CreateThreadRuntime(fn_: *byte, name: *byte, data: *byte, pfnBeginThread: *byte, pfnEndThread: *byte): i32 {
    return SDL_CreateThreadRuntime(fn_, name, data, pfnBeginThread, pfnEndThread)
}

fn CreateThreadWithPropertiesRuntime(props: u32, pfnBeginThread: *byte, pfnEndThread: *byte): i32 {
    return SDL_CreateThreadWithPropertiesRuntime(props, pfnBeginThread, pfnEndThread)
}

fn GetThreadState(thread: *byte): *byte {
    return SDL_GetThreadState(thread)
}

fn SetCurrentThreadPriority(priority: u32): i32 {
    return SDL_SetCurrentThreadPriority(priority)
}

fn SetTLS(id: *byte, value: *byte, destructor: *byte): i32 {
    return SDL_SetTLS(id, value, destructor)
}

