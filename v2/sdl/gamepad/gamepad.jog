// Idiomatic v2 wrappers for SDL gamepad (flat merge; calls SDL_* directly).
// Variadics / by-value structs omitted — see JogDocs Friction.

fn AddGamepadMapping(mapping: *byte): i32 {
    return SDL_AddGamepadMapping(mapping)
}

fn AddGamepadMappingsFromIO(src: *byte, closeio: i32): i32 {
    return SDL_AddGamepadMappingsFromIO(src, closeio)
}

fn AddGamepadMappingsFromFile(file: *byte): i32 {
    return SDL_AddGamepadMappingsFromFile(file)
}

fn ReloadGamepadMappings(): i32 {
    return SDL_ReloadGamepadMappings()
}

fn GetGamepadMappings(count: *byte): **byte {
    return SDL_GetGamepadMappings(count)
}

fn GetGamepadMapping(gamepad: *byte): *byte {
    return SDL_GetGamepadMapping(gamepad)
}

fn SetGamepadMapping(instance_id: u32, mapping: *byte): i32 {
    return SDL_SetGamepadMapping(instance_id, mapping)
}

fn HasGamepad(): i32 {
    return SDL_HasGamepad()
}

fn GetGamepads(count: *byte): *byte {
    return SDL_GetGamepads(count)
}

fn IsGamepad(instance_id: u32): i32 {
    return SDL_IsGamepad(instance_id)
}

