// Jog-facing SDL3 API for Jog v2. Raw @link symbols live in sdl3.jog (same module).
// Package-level vals are compile-time constants (JOG-89).

val INIT_VIDEO: u32 = 0x00000020
val EVENT_QUIT: u32 = 0x100
val EVENT_WINDOW_CLOSE_REQUESTED: u32 = 0x210
val EVENT_KEY_DOWN: u32 = 0x300
val EVENT_KEY_UP: u32 = 0x301
val WINDOW_RESIZABLE: u64 = 0x0000000000000020

val SCANCODE_A: u32 = 4
val SCANCODE_D: u32 = 7
val SCANCODE_S: u32 = 22
val SCANCODE_W: u32 = 26
val SCANCODE_ESCAPE: u32 = 41
val SCANCODE_RIGHT: u32 = 79
val SCANCODE_LEFT: u32 = 80

val PIXELFORMAT_ARGB8888: u32 = 0x16362004
val TEXTUREACCESS_STREAMING: i32 = 1

struct Window {
    ptr: *byte
}

struct Renderer {
    ptr: *byte
}

struct Texture {
    ptr: *byte
    w: i32
    h: i32
}

struct Event {
    kind: u32
    scancode: u32
}

struct FRect {
    x: f32
    y: f32
    w: f32
    h: f32
}

fn frect(x: f32, y: f32, w: f32, h: f32): FRect {
    return FRect(x: x, y: y, w: w, h: h)
}

fn Init(flags: u32): i32 {
    return SDL_Init(flags)
}

fn Quit() {
    SDL_Quit()
}

fn CreateWindow(title: *byte, w: i32, h: i32, flags: u64): Window {
    var win = Window(ptr: null)
    win.ptr = SDL_CreateWindow(title, w, h, flags)
    return win
}

fn Window.destroy() {
    if (self.ptr != null) {
        SDL_DestroyWindow(self.ptr)
    }
}

fn Window.create_renderer(): Renderer {
    var ren = Renderer(ptr: null)
    ren.ptr = SDL_CreateRenderer(self.ptr, null)
    return ren
}

fn Renderer.destroy() {
    if (self.ptr != null) {
        SDL_DestroyRenderer(self.ptr)
    }
}

fn Renderer.set_draw_color(r: u8, g: u8, b: u8, a: u8): i32 {
    return SDL_SetRenderDrawColor(self.ptr, r, g, b, a)
}

fn Renderer.clear(): i32 {
    return SDL_RenderClear(self.ptr)
}

fn Renderer.present(): i32 {
    return SDL_RenderPresent(self.ptr)
}

fn Renderer.fill_rect(rect: *FRect): i32 {
    // *FRect coerces to *byte at the extern edge.
    return SDL_RenderFillRect(self.ptr, rect)
}

fn Renderer.create_streaming_texture(w: i32, h: i32): Texture {
    var tex = Texture(ptr: null, w: 0, h: 0)
    tex.ptr = SDL_CreateTexture(self.ptr, PIXELFORMAT_ARGB8888, TEXTUREACCESS_STREAMING, w, h)
    tex.w = w
    tex.h = h
    return tex
}

fn Renderer.draw_texture(tex: Texture): i32 {
    return SDL_RenderTexture(self.ptr, tex.ptr, null, null)
}

fn Texture.destroy() {
    if (self.ptr != null) {
        SDL_DestroyTexture(self.ptr)
    }
}

fn Texture.update(pixels: *byte): i32 {
    val pitch = self.w * 4
    return SDL_UpdateTexture(self.ptr, null, pixels, pitch)
}

fn PollEventHas(buf: *byte): i32 {
    return SDL_PollEvent(buf)
}

fn Delay(ms: u32) {
    SDL_Delay(ms)
}

fn GetTicks(): u64 {
    return SDL_GetTicks()
}
