// Window smoke for Jog v2 + local SDL3 prefix (libdir → -L + rpath).
// Host while-loop on the platform thread (no jog_host_run_loop on v2; F4).
// Avoid with(dispatcher_io) around SDL — keep the default pool unblocked.

fn main() {
    if (Init(INIT_VIDEO()) == 0) {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL v2", 640, 480, WINDOW_RESIZABLE())
    if (win.ptr == null) {
        panic("SDL CreateWindow failed\n")
    }

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("SDL CreateRenderer failed\n")
    }

    val evbuf = alloc(128)
    var running = 1
    var rect = frect(220.0 as f32, 160.0 as f32, 200.0 as f32, 160.0 as f32)
    val start = GetTicks()
    // Auto-exit after ~1.5s so agents/CI can prove a run without input.
    val limit_ms: u64 = 1500

    while (running != 0) {
        while (PollEventHas(evbuf) != 0) {
            val kind = *evbuf
            if (kind == EVENT_QUIT() || kind == EVENT_WINDOW_CLOSE_REQUESTED()) {
                running = 0
            }
            if (kind == EVENT_KEY_DOWN()) {
                val sc = *(evbuf + 24)
                if (sc == SCANCODE_ESCAPE()) {
                    running = 0
                }
            }
        }

        if (running == 0) {
            break
        }
        if (GetTicks() - start >= limit_ms) {
            break
        }

        ren.set_draw_color(12, 48, 64, 255)
        ren.clear()
        ren.set_draw_color(80, 200, 180, 255)
        ren.fill_rect(&rect)
        ren.present()
        Delay(16)
    }

    ren.destroy()
    win.destroy()
    Quit()
    print("window demo exit\n")
}
