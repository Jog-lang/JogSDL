// CPU texture substrate for software FB (walls + mesh share this path).
// ARGB8888 little-endian in memory (B,G,R,A) matching world.jog poke32.
// No SDL GPU / shaders. Scalar + *byte only (no struct returns / bump drain).
import std.math

extern {
    fn fopen(path: *byte, mode: *byte): *byte
    fn fread(ptr: *byte, size: u64, nmemb: u64, stream: *byte): u64
    fn fwrite(ptr: *byte, size: u64, nmemb: u64, stream: *byte): u64
    fn fclose(stream: *byte): i32
}

// Last successful load size (PPM / ARGB atlas).
var tex_w: i64 = 0
var tex_h: i64 = 0

fn tex_poke32(p: *byte, off: i64, v: i64) {
    p[off] = v & 255
    p[off + 1] = (v >> 8) & 255
    p[off + 2] = (v >> 16) & 255
    p[off + 3] = (v >> 24) & 255
}

fn tex_peek32(p: *byte, off: i64): i64 {
    val b0 = p[off]
    val b1 = p[off + 1]
    val b2 = p[off + 2]
    val b3 = p[off + 3]
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
}

// Wrap into [0, 1).
fn tex_wrap01(t: f64): f64 {
    var x = t - floor(t)
    if (x < 0.0) {
        x = x + 1.0
    }
    if (x >= 1.0) {
        x = 0.0
    }
    return x
}

// Nearest-neighbor sample; u,v typically [0,1], wrapped.
fn tex_sample(pixels: *byte, w: i64, h: i64, u: f64, v: f64): i64 {
    if (pixels == null || w <= 0 || h <= 0) {
        return 0
    }
    val uu = tex_wrap01(u)
    val vv = tex_wrap01(v)
    var tx = floor(uu * (w as f64)) as i64
    var ty = floor(vv * (h as f64)) as i64
    if (tx < 0) {
        tx = 0
    }
    if (ty < 0) {
        ty = 0
    }
    if (tx >= w) {
        tx = w - 1
    }
    if (ty >= h) {
        ty = h - 1
    }
    return tex_peek32(pixels, (ty * w + tx) * 4)
}

// Darken RGB for classic raycaster side shading (keep alpha).
fn tex_shade(argb: i64, side: i64): i64 {
    if (side == 0) {
        return argb
    }
    val a = argb & 4278190080
    val r = ((argb >> 16) & 255) >> 1
    val g = ((argb >> 8) & 255) >> 1
    val b = (argb & 255) >> 1
    return a + (r << 16) + (g << 8) + b
}

// Procedural checker atlas (in-repo bake without shipping bytes).
fn tex_fill_checker(pixels: *byte, w: i64, h: i64, c0: i64, c1: i64, cell: i64) {
    var y: i64 = 0
    while (y < h) {
        var x: i64 = 0
        while (x < w) {
            var use1 = 0
            if (cell > 0) {
                val cx = x / cell
                val cy = y / cell
                if (((cx + cy) & 1) != 0) {
                    use1 = 1
                }
            }
            var c = c0
            if (use1 != 0) {
                c = c1
            }
            tex_poke32(pixels, (y * w + x) * 4, c)
            x = x + 1
        }
        y = y + 1
    }
    tex_w = w
    tex_h = h
}

fn tex_is_ws(b: i64): i64 {
    if (b == 32 || b == 9 || b == 10 || b == 13) {
        return 1
    }
    return 0
}

// Skip PPM whitespace and `#` comment lines. Returns new index or -1.
fn tex_ppm_skip(buf: *byte, n: i64, start: i64): i64 {
    var i = start
    while (i < n) {
        val b = buf[i]
        if (b == 35) {
            while (i < n && buf[i] != 10) {
                i = i + 1
            }
            if (i < n) {
                i = i + 1
            }
        } else {
            if (tex_is_ws(b) != 0) {
                i = i + 1
            } else {
                return i
            }
        }
    }
    return 0 - 1
}

fn tex_ppm_read_int(buf: *byte, n: i64, start: i64): i64 {
    // Writes parsed value into tex_parse_val; returns next index or -1.
    var i = tex_ppm_skip(buf, n, start)
    if (i < 0) {
        return 0 - 1
    }
    var v: i64 = 0
    var digits = 0
    while (i < n) {
        val b = buf[i]
        if (b < 48 || b > 57) {
            break
        }
        v = v * 10 + (b - 48)
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return 0 - 1
    }
    tex_parse_val = v
    return i
}

var tex_parse_val: i64 = 0

// Decode P6 bytes already in memory into ARGB out (cap = out bytes).
// Returns 0 on success; sets tex_w / tex_h.
fn tex_decode_ppm(buf: *byte, n: i64, out: *byte, out_cap: i64): i64 {
    if (buf == null || out == null || n < 8) {
        return 0 - 1
    }
    if (buf[0] != 80 || buf[1] != 54) {
        return 0 - 2
    }
    var i = 2
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val w = tex_parse_val
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val h = tex_parse_val
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val maxv = tex_parse_val
    if (w <= 0 || h <= 0 || maxv != 255) {
        return 0 - 4
    }
    i = tex_ppm_skip(buf, n, i)
    if (i < 0) {
        return 0 - 5
    }
    // Single whitespace separator before binary payload.
    if (tex_is_ws(buf[i]) != 0) {
        i = i + 1
    }
    val need = w * h * 3
    if (i + need > n) {
        return 0 - 6
    }
    val out_need = w * h * 4
    if (out_need > out_cap) {
        return 0 - 7
    }
    var p = 0
    var o = 0
    while (p < need) {
        val r = buf[i + p]
        val g = buf[i + p + 1]
        val b = buf[i + p + 2]
        // AARRGGBB
        val argb = 4278190080 + (r << 16) + (g << 8) + b
        tex_poke32(out, o, argb)
        p = p + 3
        o = o + 4
    }
    tex_w = w
    tex_h = h
    return 0
}

fn tex_load_file(path: *byte, dest: *byte, cap: i64): i64 {
    // Returns bytes read into dest, or -1 on failure.
    val f = fopen(path, c"rb")
    if (f == null) {
        return 0 - 1
    }
    val n = fread(dest, 1, cap as u64, f)
    fclose(f)
    return n as i64
}

// Load P6 PPM from path into ARGB out. Returns 0 on success.
fn tex_load_ppm(path: *byte, out: *byte, out_cap: i64): i64 {
    // Cap raw file read; 64 KiB is enough for demo atlases.
    val raw_cap: i64 = 65536
    val raw = alloc(raw_cap)
    if (raw == null) {
        return 0 - 10
    }
    val n = tex_load_file(path, raw, raw_cap)
    if (n <= 0) {
        return 0 - 11
    }
    return tex_decode_ppm(raw, n, out, out_cap)
}

// Baked atlas: magic "ARGB" + u32le w + u32le h + w*h ARGB8888 LE pixels.
fn tex_decode_argb(buf: *byte, n: i64, out: *byte, out_cap: i64): i64 {
    if (buf == null || out == null || n < 12) {
        return 0 - 1
    }
    if (buf[0] != 65 || buf[1] != 82 || buf[2] != 71 || buf[3] != 66) {
        return 0 - 2
    }
    val w = tex_peek32(buf, 4)
    val h = tex_peek32(buf, 8)
    if (w <= 0 || h <= 0) {
        return 0 - 3
    }
    val pix_bytes = w * h * 4
    if (12 + pix_bytes > n) {
        return 0 - 4
    }
    if (pix_bytes > out_cap) {
        return 0 - 5
    }
    var i: i64 = 0
    while (i < pix_bytes) {
        out[i] = buf[12 + i]
        i = i + 1
    }
    tex_w = w
    tex_h = h
    return 0
}

fn tex_load_argb(path: *byte, out: *byte, out_cap: i64): i64 {
    val raw_cap: i64 = 65536
    val raw = alloc(raw_cap)
    if (raw == null) {
        return 0 - 10
    }
    val n = tex_load_file(path, raw, raw_cap)
    if (n <= 0) {
        return 0 - 11
    }
    return tex_decode_argb(raw, n, out, out_cap)
}

// Blit one sampled texel into a software FB (ARGB8888).
fn tex_put_fb(fb: *byte, fb_w: i64, x: i64, y: i64, argb: i64) {
    tex_poke32(fb, (y * fb_w + x) * 4, argb)
}
