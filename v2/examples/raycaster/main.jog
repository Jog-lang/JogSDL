// Proto-3D software raycaster on Jog v2 (float camera basis).
// WASD move/strafe, arrows or mouse-x look, E/Space toggle door ahead.
// Default: interactive until Escape / window close (native while-loop; F16 open).
// Soft frame cap: JOGSDL_RAYCASTER_SMOKE=1 (or true) for agent/CI.
// Camera lives in package scalars (world.jog) — no per-frame struct bump allocs.

extern {
    fn getenv(name: *byte): *byte
    fn strcmp(a: *byte, b: *byte): i32
}

val WIN_W: i32 = 640
val WIN_H: i32 = 400
val FB_W: i64 = 160
val FB_H: i64 = 100
val FB_W32: i32 = 160
val FB_H32: i32 = 100
val FB_BYTES: u64 = 64000
val SMOKE_FRAMES: i64 = 180
val PLANE_LEN: f64 = 0.66

fn wants_smoke(): i64 {
    val p = getenv(c"JOGSDL_RAYCASTER_SMOKE")
    if (p == null) {
        return 0
    }
    if (strcmp(p, c"1") == 0) {
        return 1
    }
    if (strcmp(p, c"true") == 0) {
        return 1
    }
    return 0
}

fn main() {
    val smoke = wants_smoke()

    if (Init(INIT_VIDEO) == 0) {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL raycaster proto-3D", WIN_W, WIN_H, WINDOW_RESIZABLE)
    if (win.ptr == null) {
        panic("CreateWindow failed\n")
    }
    // Relative mouse for look; ignore failure (headless / no grab).
    win.set_relative_mouse(1)

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("CreateRenderer failed\n")
    }
    var tex = ren.create_streaming_texture(FB_W32, FB_H32)
    if (tex.ptr == null) {
        panic("CreateTexture failed\n")
    }

    val pixels = alloc(FB_BYTES)
    if (pixels == null) {
        panic("alloc framebuffer failed\n")
    }
    val map = demo_map()
    // Spawn facing +x toward the interactive door at (5,2).
    set_camera(2.5, 2.5, 1.0, 0.0, 0.0, PLANE_LEN)
    var key_use = 0
    var key_use_prev = 0
    val evbuf = alloc(128)
    var mx: f32 = 0.0 as f32
    var my: f32 = 0.0 as f32
    var running = 1
    var frames = 0
    val dt: f64 = 0.016

    while (running != 0) {
        while (PollEventHas(evbuf) != 0) {
            val kind = *evbuf
            if (kind == EVENT_QUIT || kind == EVENT_WINDOW_CLOSE_REQUESTED) {
                running = 0
            }
            if (kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP) {
                val sc = *(evbuf + 24)
                var down = 0
                if (kind == EVENT_KEY_DOWN) {
                    down = 1
                }
                if (sc == SCANCODE_ESCAPE) {
                    running = 0
                }
                // E/Space edge-trigger still from events; movement uses keyboard state.
                if (sc == SCANCODE_E || sc == SCANCODE_SPACE) { key_use = down }
            }
        }
        if (running == 0) {
            break
        }
        // Soft cap only when JOGSDL_RAYCASTER_SMOKE is set (default stays open).
        if (smoke != 0 && frames >= SMOKE_FRAMES) {
            break
        }

        // Keyboard state (not only KEY_DOWN edges) so held keys work after focus return.
        val key_w = KeyboardIsDown(SCANCODE_W)
        val key_s = KeyboardIsDown(SCANCODE_S)
        val key_a = KeyboardIsDown(SCANCODE_A)
        val key_d = KeyboardIsDown(SCANCODE_D)
        val key_left = KeyboardIsDown(SCANCODE_LEFT)
        val key_right = KeyboardIsDown(SCANCODE_RIGHT)

        var yaw = 0.0
        if (key_left != 0) {
            yaw = yaw + dt * 2.5
        }
        if (key_right != 0) {
            yaw = yaw - dt * 2.5
        }
        // Mouse X look (relative mode); scale is radians per pixel.
        ReadRelativeMouse(&mx, &my)
        yaw = yaw - (mx as f64) * 0.003
        if (yaw != 0.0) {
            rotate_cam_yaw(yaw)
        }

        val move = dt * 3.0
        if (key_w != 0) {
            try_move(map, cam_dir_x * move, cam_dir_y * move)
        }
        if (key_s != 0) {
            try_move(map, cam_dir_x * (0.0 - move), cam_dir_y * (0.0 - move))
        }
        if (key_a != 0) {
            try_move(map, cam_plane_x * (0.0 - move), cam_plane_y * (0.0 - move))
        }
        if (key_d != 0) {
            try_move(map, cam_plane_x * move, cam_plane_y * move)
        }
        if (key_use != 0 && key_use_prev == 0) {
            try_use_door(map)
        }
        key_use_prev = key_use

        render_frame(pixels, map, FB_W, FB_H)
        if (frames == 0 && smoke != 0) {
            map_cast(map, cam_pos_x, cam_pos_y, cam_dir_x, cam_dir_y)
            if (hit_dist == 2.5 && hit_wall == 5) {
                print("map_cast door ahead ok\n")
            } else {
                print("map_cast door ahead BAD\n")
            }
            dump_fb_ppm(pixels, FB_W, FB_H)
        }
        tex.update(pixels)
        ren.set_draw_color(0, 0, 0, 255)
        ren.clear()
        ren.draw_texture(tex)
        ren.present()
        Delay(16)
        frames = frames + 1
    }

    win.set_relative_mouse(0)
    tex.destroy()
    ren.destroy()
    win.destroy()
    Quit()
    print("raycaster exit\n")
}
