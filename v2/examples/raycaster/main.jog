// Proto-3D software raycaster on Jog v2 (float Vec2 + view basis).
// WASD move/strafe, arrows or mouse-x look, E/Space toggle door ahead.
// Soft-capped frames for agent/CI smoke (native while-loop; F16 still open).

val WIN_W: i32 = 640
val WIN_H: i32 = 400
val FB_W: i64 = 160
val FB_H: i64 = 100
val FB_W32: i32 = 160
val FB_H32: i32 = 100
val FB_BYTES: u64 = 64000
val MAX_FRAMES: i64 = 180
val PLANE_LEN: f64 = 0.66

fn main() {
    if (Init(INIT_VIDEO) == 0) {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL raycaster proto-3D", WIN_W, WIN_H, WINDOW_RESIZABLE)
    if (win.ptr == null) {
        panic("CreateWindow failed\n")
    }
    // Relative mouse for look; ignore failure (headless / no grab).
    win.set_relative_mouse(1)

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("CreateRenderer failed\n")
    }
    var tex = ren.create_streaming_texture(FB_W32, FB_H32)
    if (tex.ptr == null) {
        panic("CreateTexture failed\n")
    }

    val pixels = alloc(FB_BYTES)
    if (pixels == null) {
        panic("alloc framebuffer failed\n")
    }
    val map = demo_map()
    // Spawn facing +x toward the interactive door at (5,2).
    var cam = camera_at(vec2(2.5, 2.5), vec2(1.0, 0.0), vec2(0.0, PLANE_LEN))
    var key_w = 0
    var key_s = 0
    var key_a = 0
    var key_d = 0
    var key_left = 0
    var key_right = 0
    var key_use = 0
    var key_use_prev = 0
    val evbuf = alloc(128)
    var running = 1
    var frames = 0
    val dt: f64 = 0.016

    while (running != 0) {
        while (PollEventHas(evbuf) != 0) {
            val kind = *evbuf
            if (kind == EVENT_QUIT || kind == EVENT_WINDOW_CLOSE_REQUESTED) {
                running = 0
            }
            if (kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP) {
                val sc = *(evbuf + 24)
                var down = 0
                if (kind == EVENT_KEY_DOWN) {
                    down = 1
                }
                if (sc == SCANCODE_ESCAPE) {
                    running = 0
                }
                if (sc == SCANCODE_W) { key_w = down }
                if (sc == SCANCODE_S) { key_s = down }
                if (sc == SCANCODE_A) { key_a = down }
                if (sc == SCANCODE_D) { key_d = down }
                if (sc == SCANCODE_LEFT) { key_left = down }
                if (sc == SCANCODE_RIGHT) { key_right = down }
                if (sc == SCANCODE_E || sc == SCANCODE_SPACE) { key_use = down }
            }
        }
        if (running == 0) {
            break
        }
        if (frames >= MAX_FRAMES) {
            break
        }

        var yaw = 0.0
        if (key_left != 0) {
            yaw = yaw + dt * 2.5
        }
        if (key_right != 0) {
            yaw = yaw - dt * 2.5
        }
        // Mouse X look (relative mode); scale is radians per pixel.
        val md = GetRelativeMouseDelta()
        yaw = yaw - (md.x as f64) * 0.003
        if (yaw != 0.0) {
            cam.rotate(yaw)
        }

        val move = dt * 3.0
        if (key_w != 0) {
            cam = try_move_cam(cam, map, cam.basis.dir.scale(move))
        }
        if (key_s != 0) {
            cam = try_move_cam(cam, map, cam.basis.dir.scale(0.0 - move))
        }
        if (key_a != 0) {
            cam = try_move_cam(cam, map, cam.basis.plane.scale(0.0 - move))
        }
        if (key_d != 0) {
            cam = try_move_cam(cam, map, cam.basis.plane.scale(move))
        }
        if (key_use != 0 && key_use_prev == 0) {
            try_use_door(cam, map)
        }
        key_use_prev = key_use

        render_frame(pixels, map, cam, FB_W, FB_H)
        tex.update(pixels)
        ren.set_draw_color(0, 0, 0, 255)
        ren.clear()
        ren.draw_texture(tex)
        ren.present()
        frames = frames + 1
    }

    win.set_relative_mouse(0)
    tex.destroy()
    ren.destroy()
    win.destroy()
    Quit()
    print("raycaster exit\n")
}
