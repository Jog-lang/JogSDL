// Emscripten proto-3D raycaster (JOG-90 + JOG-105).
// Returning jog_host_run_loop; App object holds handles (JOG-96 / F17 path).
// Same float Vec2 + view basis / doors as the native demo.

val WIN_W: i32 = 640
val WIN_H: i32 = 400
val FB_W: i64 = 160
val FB_H: i64 = 100
val FB_W32: i32 = 160
val FB_H32: i32 = 100
val FB_BYTES: u64 = 64000
val PLANE_LEN: f64 = 0.66

// JOG-96 object singleton — multi-field package state without F17 scalar split.
object App {
    win_ptr: *byte
    ren_ptr: *byte
    tex_ptr: *byte
    pixels: *byte
    map: *byte
    evbuf: *byte
    running: i64
    frames: i64
    pos_x: f64
    pos_y: f64
    dir_x: f64
    dir_y: f64
    plane_x: f64
    plane_y: f64
    key_w: i64
    key_s: i64
    key_a: i64
    key_d: i64
    key_left: i64
    key_right: i64
    key_use: i64
    key_use_prev: i64
}

fn app_camera(): Camera {
    return camera_at(
        vec2(App.pos_x, App.pos_y),
        vec2(App.dir_x, App.dir_y),
        vec2(App.plane_x, App.plane_y)
    )
}

fn app_store_camera(cam: Camera) {
    App.pos_x = cam.pos.x
    App.pos_y = cam.pos.y
    App.dir_x = cam.basis.dir.x
    App.dir_y = cam.basis.dir.y
    App.plane_x = cam.basis.plane.x
    App.plane_y = cam.basis.plane.y
}

@export
fn tick(): i32 {
    while (PollEventHas(App.evbuf) != 0) {
        val kind = *App.evbuf
        if (kind == EVENT_QUIT || kind == EVENT_WINDOW_CLOSE_REQUESTED) {
            App.running = 0
        }
        if (kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP) {
            val sc = *(App.evbuf + 24)
            var down = 0
            if (kind == EVENT_KEY_DOWN) {
                down = 1
            }
            if (sc == SCANCODE_ESCAPE) {
                App.running = 0
            }
            if (sc == SCANCODE_W) { App.key_w = down }
            if (sc == SCANCODE_S) { App.key_s = down }
            if (sc == SCANCODE_A) { App.key_a = down }
            if (sc == SCANCODE_D) { App.key_d = down }
            if (sc == SCANCODE_LEFT) { App.key_left = down }
            if (sc == SCANCODE_RIGHT) { App.key_right = down }
            if (sc == SCANCODE_E || sc == SCANCODE_SPACE) { App.key_use = down }
        }
    }
    if (App.running == 0) {
        return 0
    }

    var cam = app_camera()
    val dt: f64 = 0.016
    var yaw = 0.0
    if (App.key_left != 0) {
        yaw = yaw + dt * 2.5
    }
    if (App.key_right != 0) {
        yaw = yaw - dt * 2.5
    }
    val md = GetRelativeMouseDelta()
    yaw = yaw - (md.x as f64) * 0.003
    if (yaw != 0.0) {
        cam.rotate(yaw)
    }

    val move = dt * 3.0
    if (App.key_w != 0) {
        cam = try_move_cam(cam, App.map, cam.basis.dir.scale(move))
    }
    if (App.key_s != 0) {
        cam = try_move_cam(cam, App.map, cam.basis.dir.scale(0.0 - move))
    }
    if (App.key_a != 0) {
        cam = try_move_cam(cam, App.map, cam.basis.plane.scale(0.0 - move))
    }
    if (App.key_d != 0) {
        cam = try_move_cam(cam, App.map, cam.basis.plane.scale(move))
    }
    if (App.key_use != 0 && App.key_use_prev == 0) {
        try_use_door(cam, App.map)
    }
    App.key_use_prev = App.key_use
    app_store_camera(cam)

    render_frame(App.pixels, App.map, cam, FB_W, FB_H)

    var tex = Texture(ptr: App.tex_ptr, w: FB_W32, h: FB_H32)
    tex.update(App.pixels)
    var ren = Renderer(ptr: App.ren_ptr)
    ren.set_draw_color(0, 0, 0, 255)
    ren.clear()
    ren.draw_texture(tex)
    ren.present()
    App.frames = App.frames + 1
    return 1
}

fn main() {
    if (Init(INIT_VIDEO) == 0) {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL raycaster wasm proto-3D", WIN_W, WIN_H, WINDOW_RESIZABLE)
    if (win.ptr == null) {
        panic("CreateWindow failed\n")
    }
    App.win_ptr = win.ptr
    win.set_relative_mouse(1)

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("CreateRenderer failed\n")
    }
    App.ren_ptr = ren.ptr

    var tex = ren.create_streaming_texture(FB_W32, FB_H32)
    if (tex.ptr == null) {
        panic("CreateTexture failed\n")
    }
    App.tex_ptr = tex.ptr

    App.pixels = alloc(FB_BYTES)
    if (App.pixels == null) {
        panic("alloc framebuffer failed\n")
    }
    App.map = demo_map()
    App.evbuf = alloc(128)
    App.pos_x = 2.5
    App.pos_y = 2.5
    App.dir_x = 1.0
    App.dir_y = 0.0
    App.plane_x = 0.0
    App.plane_y = PLANE_LEN
    App.running = 1
    App.frames = 0
    App.key_use = 0
    App.key_use_prev = 0

    jog_host_run_loop(tick)

    win.set_relative_mouse(0)
    tex.destroy()
    ren.destroy()
    win.destroy()
    Quit()
    print("raycaster emscripten exit\n")
}
