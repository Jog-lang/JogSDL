// Emscripten proto-3D raycaster (JOG-90 + JOG-105).
// Returning jog_host_run_loop; App object holds SDL handles (JOG-96 / F17 path).
// Camera/DDA use package scalars in world.jog (heap-safe hot path).

val WIN_W: i32 = 640
val WIN_H: i32 = 400
val FB_W: i64 = 160
val FB_H: i64 = 100
val FB_W32: i32 = 160
val FB_H32: i32 = 100
val FB_BYTES: u64 = 64000
val PLANE_LEN: f64 = 0.66

// JOG-96 object singleton — SDL handles + input (camera is package cam_*).
object App {
    win_ptr: *byte
    ren_ptr: *byte
    tex_ptr: *byte
    pixels: *byte
    map: *byte
    evbuf: *byte
    running: i64
    frames: i64
    key_w: i64
    key_s: i64
    key_a: i64
    key_d: i64
    key_left: i64
    key_right: i64
    key_use: i64
    key_use_prev: i64
}

@export
fn tick(): i32 {
    while (PollEventHas(App.evbuf) != 0) {
        val kind = *App.evbuf
        if (kind == EVENT_QUIT || kind == EVENT_WINDOW_CLOSE_REQUESTED) {
            App.running = 0
        }
        if (kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP) {
            val sc = *(App.evbuf + 24)
            var down = 0
            if (kind == EVENT_KEY_DOWN) {
                down = 1
            }
            if (sc == SCANCODE_ESCAPE) {
                App.running = 0
            }
            if (sc == SCANCODE_W) { App.key_w = down }
            if (sc == SCANCODE_S) { App.key_s = down }
            if (sc == SCANCODE_A) { App.key_a = down }
            if (sc == SCANCODE_D) { App.key_d = down }
            if (sc == SCANCODE_LEFT) { App.key_left = down }
            if (sc == SCANCODE_RIGHT) { App.key_right = down }
            if (sc == SCANCODE_E || sc == SCANCODE_SPACE) { App.key_use = down }
        }
    }
    if (App.running == 0) {
        return 0
    }

    val dt: f64 = 0.016
    var yaw = 0.0
    if (App.key_left != 0) {
        yaw = yaw * 1.0 + dt * 2.5
    }
    if (App.key_right != 0) {
        yaw = yaw * 1.0 - dt * 2.5
    }
    var mx: f32 = 0.0 as f32
    var my: f32 = 0.0 as f32
    ReadRelativeMouse(&mx, &my)
    yaw = yaw * 1.0 - (mx as f64) * 0.003
    if (yaw != 0.0) {
        rotate_cam_yaw(yaw)
    }

    val move = dt * 3.0
    if (App.key_w != 0) {
        try_move(App.map, cam_dir_x * 1.0 * move, cam_dir_y * 1.0 * move)
    }
    if (App.key_s != 0) {
        try_move(App.map, cam_dir_x * 1.0 * (0.0 - move), cam_dir_y * 1.0 * (0.0 - move))
    }
    if (App.key_a != 0) {
        try_move(App.map, cam_plane_x * 1.0 * (0.0 - move), cam_plane_y * 1.0 * (0.0 - move))
    }
    if (App.key_d != 0) {
        try_move(App.map, cam_plane_x * 1.0 * move, cam_plane_y * 1.0 * move)
    }
    if (App.key_use != 0 && App.key_use_prev == 0) {
        try_use_door(App.map)
    }
    App.key_use_prev = App.key_use

    render_frame(App.pixels, App.map, FB_W, FB_H)

    UpdateTextureRaw(App.tex_ptr, App.pixels, FB_W32 * 4)
    SetDrawColorRaw(App.ren_ptr, 0, 0, 0, 255)
    ClearRaw(App.ren_ptr)
    DrawTextureRaw(App.ren_ptr, App.tex_ptr)
    PresentRaw(App.ren_ptr)
    App.frames = App.frames + 1
    return 1
}

fn main() {
    if (Init(INIT_VIDEO) == 0) {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL raycaster wasm proto-3D", WIN_W, WIN_H, WINDOW_RESIZABLE)
    if (win.ptr == null) {
        panic("CreateWindow failed\n")
    }
    App.win_ptr = win.ptr
    win.set_relative_mouse(1)

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("CreateRenderer failed\n")
    }
    App.ren_ptr = ren.ptr

    var tex = ren.create_streaming_texture(FB_W32, FB_H32)
    if (tex.ptr == null) {
        panic("CreateTexture failed\n")
    }
    App.tex_ptr = tex.ptr

    App.pixels = alloc(FB_BYTES)
    if (App.pixels == null) {
        panic("alloc framebuffer failed\n")
    }
    App.map = demo_map()
    App.evbuf = alloc(128)
    set_camera(2.5, 2.5, 1.0, 0.0, 0.0, PLANE_LEN)
    App.running = 1
    App.frames = 0
    App.key_use = 0
    App.key_use_prev = 0

    jog_host_run_loop(tick)

    win.set_relative_mouse(0)
    tex.destroy()
    ren.destroy()
    win.destroy()
    Quit()
    print("raycaster emscripten exit\n")
}
