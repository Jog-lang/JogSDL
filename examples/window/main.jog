import jog_sdl.sdl3

fn main() {
    if !sdl3.SDL_Init(sdl3.SDL_INIT_VIDEO) {
        panic("SDL_Init failed")
    }
    defer sdl3.SDL_Quit()

    val win = sdl3.SDL_CreateWindow(c"JogSDL", 640, 480, sdl3.SDL_WINDOW_RESIZABLE)!!
    defer sdl3.SDL_DestroyWindow(win)

    val ren = sdl3.SDL_CreateRenderer(win, null)!!
    defer sdl3.SDL_DestroyRenderer(ren)

    var running = true
    for running {
        // Construct event/rect inside jog_sdl (cross-module type names are awkward in V1).
        var event = sdl3.zero_event()
        for sdl3.SDL_PollEvent(&event) {
            if event.event_type == sdl3.SDL_EVENT_QUIT {
                running = false
            }
        }

        // Dark teal clear + a simple filled rect.
        _ = sdl3.SDL_SetRenderDrawColor(ren, 12, 48, 64, 255)
        _ = sdl3.SDL_RenderClear(ren)

        var box = sdl3.frect(220.0, 160.0, 200.0, 160.0)
        _ = sdl3.SDL_SetRenderDrawColor(ren, 80, 200, 180, 255)
        _ = sdl3.SDL_RenderFillRect(ren, &box)

        _ = sdl3.SDL_RenderPresent(ren)
        sdl3.SDL_Delay(16)
    }
}
