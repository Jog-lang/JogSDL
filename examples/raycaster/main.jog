// Proto-3D software raycaster on Jog v2 (float camera basis).
// WASD move/strafe, arrows or mouse-x yaw, mouse-y pitch (horizon), E/Space door.
// Soft-raster textured cube depth-tested against DDA walls (track C).
// Native: parallel column bands via go/Dispatcher (track E); JOGSDL_RAYCASTER_SERIAL=1 to force serial.
// Soft frame cap: JOGSDL_RAYCASTER_SMOKE=1 (or true) for agent/CI.
// Camera lives in package scalars (world.jog) — no per-frame struct bump allocs.
// Frame pacing: timing.jog (GetTicks dt + Delay-to-cap @ ~60 FPS).

extern {
    fn getenv(name: *byte): *byte
    fn strcmp(a: *byte, b: *byte): i32
}

val WIN_W: i32 = 640
val WIN_H: i32 = 400
val FB_W: i64 = 160
val FB_H: i64 = 100
val FB_W32: i32 = 160
val FB_H32: i32 = 100
val FB_BYTES: u64 = 64000
val SMOKE_FRAMES: i64 = 180
val PLANE_LEN: f64 = 0.66

fn wants_smoke(): i64 {
    val p = getenv(c"JOGSDL_RAYCASTER_SMOKE")
    if (p == null) {
        return 0
    }
    if (strcmp(p, c"1") == 0) {
        return 1
    }
    if (strcmp(p, c"true") == 0) {
        return 1
    }
    return 0
}

fn main() {
    val smoke = wants_smoke()
    // Pool before SDL — clone workers + libc/SDL malloc coexist better.
    if (parallel_wants_serial() == 0) {
        dispatcher_pool(4)
        print("parallel bands via go/Dispatcher (4 workers)\n")
    } else {
        print("parallel serial mode (JOGSDL_RAYCASTER_SERIAL)\n")
    }

    if Init(InitFlag.Video) != null {
        panic("SDL Init failed\n")
    }

    var win = CreateWindow(c"JogSDL raycaster proto-3D", WIN_W, WIN_H, WindowFlag.Resizable)
    if (win.ptr == null) {
        panic("CreateWindow failed\n")
    }
    // Relative mouse for look; ignore failure (headless / no grab).
    win.set_relative_mouse(1)

    var ren = win.create_renderer()
    if (ren.ptr == null) {
        panic("CreateRenderer failed\n")
    }
    var tex = ren.create_streaming_texture(FB_W32, FB_H32)
    if (tex.ptr == null) {
        panic("CreateTexture failed\n")
    }

    val pixels = alloc(FB_BYTES)
    if (pixels == null) {
        panic("alloc framebuffer failed\n")
    }
    if (parallel_init(FB_BYTES as i64, FB_W, FB_H) == 0) {
        panic("parallel_init failed\n")
    }
    if (depth_init(FB_W) == 0) {
        panic("depth_init failed\n")
    }
    mesh_init_checker()
    // Spawn facing +x toward the interactive door at (5,2).
    set_camera(2.5, 2.5, 1.0, 0.0, 0.0, PLANE_LEN)
    var key_use = 0
    var key_use_prev = 0
    val evbuf = alloc(128)
    // SDL writes f32 into these 4-byte cells; promote with f32_slot_to_f64 (not `as f64`).
    val mouse_f32 = alloc(8)
    var running = 1
    var frames = 0
    var input_keys_seen = 0
    var input_mouse_seen = 0
    timing_init()

    while (running != 0) {
        while (PollEventHas(evbuf) != 0) {
            val kind = EventType(evbuf)
            if (kind == EVENT_QUIT || kind == EVENT_WINDOW_CLOSE_REQUESTED) {
                running = 0
            }
            if (kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP) {
                val sc = EventScancode(evbuf)
                var down = 0
                if (kind == EVENT_KEY_DOWN) {
                    down = 1
                }
                if (sc == SCANCODE_ESCAPE) {
                    running = 0
                }
                // E/Space edge-trigger still from events; movement uses keyboard state.
                if (sc == SCANCODE_E || sc == SCANCODE_SPACE) { key_use = down }
            }
        }
        if (running == 0) {
            break
        }
        // Soft cap only when JOGSDL_RAYCASTER_SMOKE is set (default stays open).
        if (smoke != 0 && frames >= SMOKE_FRAMES) {
            break
        }

        // Thin timing hook (pitch/other tracks: keep edits away from timing.jog).
        val dt = timing_begin_frame()

        // Keyboard state (not only KEY_DOWN edges) so held keys work after focus return.
        val key_w = KeyboardIsDown(SCANCODE_W)
        val key_s = KeyboardIsDown(SCANCODE_S)
        val key_a = KeyboardIsDown(SCANCODE_A)
        val key_d = KeyboardIsDown(SCANCODE_D)
        val key_left = KeyboardIsDown(SCANCODE_LEFT)
        val key_right = KeyboardIsDown(SCANCODE_RIGHT)
        if (key_w + key_s + key_a + key_d + key_left + key_right != 0) {
            input_keys_seen = 1
        }

        var yaw = 0.0
        if (key_left != 0) {
            yaw = yaw + dt * 2.5
        }
        if (key_right != 0) {
            yaw = yaw - dt * 2.5
        }
        // Relative mouse: X → yaw (rad/px), Y → classic pitch (horizon px; clamped).
        ReadRelativeMouse(mouse_f32, mouse_f32 + 4)
        val mx = f32_slot_to_f64(mouse_f32)
        val my = f32_slot_to_f64(mouse_f32 + 4)
        if (mx != 0.0 || my != 0.0) {
            input_mouse_seen = 1
        }
        yaw = yaw - mx * 0.003
        if (yaw != 0.0) {
            rotate_cam_yaw(yaw)
        }
        // SDL +Y is down; mouse up (neg my) → look up → positive pitch → horizon lower.
        if (my != 0.0) {
            add_cam_pitch(0.0 - my * 0.35)
        }

        val move = dt * 3.0
        if (key_w != 0) {
            parallel_try_move(cam_dir_x * move, cam_dir_y * move)
        }
        if (key_s != 0) {
            parallel_try_move(cam_dir_x * (0.0 - move), cam_dir_y * (0.0 - move))
        }
        if (key_a != 0) {
            parallel_try_move(cam_plane_x * (0.0 - move), cam_plane_y * (0.0 - move))
        }
        if (key_d != 0) {
            parallel_try_move(cam_plane_x * move, cam_plane_y * move)
        }
        if (key_use != 0 && key_use_prev == 0) {
            parallel_try_use_door()
        }
        key_use_prev = key_use

        if (smoke != 0 && frames == 0) {
            // Pitch + mesh smoke: hide cube during horizon check.
            mesh_set_enabled(0)
            set_cam_pitch(30.0)
            render_frame_parallel()
            parallel_blit_to(pixels)
            parallel_map_cast_fwd()
            if (hit_dist == 2.5 && hit_wall == 5) {
                print("map_cast door ahead ok\n")
            } else {
                print("map_cast door ahead BAD\n")
            }
            val mid = (FB_W / 2) * 4
            val row0 = pixels[mid + 2]
            val row50 = pixels[(50 * FB_W + FB_W / 2) * 4 + 2]
            if (row0 == 25 && row50 == 25) {
                print("pitch horizon shift ok\n")
            } else {
                print("pitch horizon shift BAD\n")
            }
            // Visible textured cube in open corridor (before door).
            set_cam_pitch(0.0)
            mesh_set_enabled(1)
            mesh_set_spin(0.35)
            mesh_set_pos(3.6, 2.5)
            render_frame_parallel()
            parallel_blit_to(pixels)
            mesh_draw(pixels, FB_W, FB_H)
            val n0 = mesh_count_color(pixels, FB_W, FB_H, MESH_C0)
            val n1 = mesh_count_color(pixels, FB_W, FB_H, MESH_C1)
            if (n0 > 20 && n1 > 20) {
                print("mesh cube multi-color ok\n")
            } else {
                print("mesh cube multi-color BAD\n")
            }
            dump_fb_ppm(pixels, FB_W, FB_H)
            // Cube behind closed door: center column must stay door (not checker).
            mesh_set_pos(10.0, 2.5)
            mesh_set_spin(0.0)
            mesh_half = 0.2
            render_frame_parallel()
            parallel_blit_to(pixels)
            mesh_draw(pixels, FB_W, FB_H)
            var occluded = 1
            val mid = FB_W / 2
            var yy: i64 = 30
            while (yy < 70) {
                val off = (yy * FB_W + mid) * 4
                val b0 = pixels[off] & 255
                val b1 = pixels[off + 1] & 255
                val b2 = pixels[off + 2] & 255
                val b3 = pixels[off + 3] & 255
                val got = b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
                if (got == MESH_C0 || got == MESH_C1) {
                    occluded = 0
                }
                yy = yy + 1
            }
            if (occluded != 0) {
                print("mesh cube occluded ok\n")
            } else {
                print("mesh cube occluded BAD\n")
            }
            mesh_half = 0.28
            mesh_set_pos(9.0, 6.0)
            mesh_set_spin(0.0)
        } else {
            if (smoke == 0) {
                mesh_update(dt)
            }
            render_frame_parallel()
            parallel_blit_to(pixels)
            mesh_draw(pixels, FB_W, FB_H)
        }
        tex.update(pixels)
        ren.set_draw_color(0, 0, 0, 255)
        ren.clear()
        ren.draw_texture(tex)
        ren.present()
        timing_end_frame()
        frames = frames + 1
    }

    timing_flush()
    win.set_relative_mouse(0)
    tex.destroy()
    ren.destroy()
    win.destroy()
    Quit()
    if (smoke != 0) {
        // Smoke cannot prove live keys; JOGSDL_INPUT_SELFTEST does (see input_selftest).
        print("raycaster exit\n")
    } else {
        if (input_keys_seen != 0) {
            print("input keys seen\n")
        }
        if (input_mouse_seen != 0) {
            print("input mouse seen\n")
        }
        print("raycaster exit\n")
    }
}
