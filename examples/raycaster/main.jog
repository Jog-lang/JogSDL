import jog_sdl.sdl
import std.math
import std.mem

val SCREEN_W: i32 = 640
val SCREEN_H: i32 = 400
val MOVE_SPEED: f64 = 3.0
val ROT_SPEED: f64 = 2.0

// Frame state at package scope so the @export tick can see it.
var g_running: bool = false
var g_win: sdl.Window
var g_ren: sdl.Renderer
var g_tex: sdl.Texture
var g_pixels: []u32
var g_map: Map
var g_pos_x: f64 = 2.5
var g_pos_y: f64 = 2.5
var g_dir_x: f64 = 1.0
var g_dir_y: f64 = 0.0
var g_plane_x: f64 = 0.0
var g_plane_y: f64 = 0.66
var g_last_ticks: u64 = 0

extern {
    fn jog_host_run_loop(tick: extern () -> i32)
}

/**
 * One frame for desktop and Emscripten. Return 0 to stop the host loop.
 */
@export
fn tick_frame(): i32 {
    for {
        val (ev, ok) = sdl.PollEvent()
        if !ok {
            break
        }
        if ev.kind == sdl.EVENT_QUIT || ev.kind == sdl.EVENT_WINDOW_CLOSE_REQUESTED {
            g_running = false
        }
        if ev.kind == sdl.EVENT_KEY_DOWN && ev.scancode == sdl.SCANCODE_ESCAPE {
            g_running = false
        }
    }
    if !g_running {
        return 0
    }

    val now = sdl.GetTicks()
    var dt = (now - g_last_ticks) as f64 / 1000.0
    g_last_ticks = now
    if dt > 0.05 {
        dt = 0.05
    }

    if sdl.KeyboardIsDown(sdl.SCANCODE_LEFT) {
        val rot = ROT_SPEED * dt
        val old_dir_x = g_dir_x
        g_dir_x = g_dir_x * math.cos(rot) - g_dir_y * math.sin(rot)
        g_dir_y = old_dir_x * math.sin(rot) + g_dir_y * math.cos(rot)
        val old_plane_x = g_plane_x
        g_plane_x = g_plane_x * math.cos(rot) - g_plane_y * math.sin(rot)
        g_plane_y = old_plane_x * math.sin(rot) + g_plane_y * math.cos(rot)
    }
    if sdl.KeyboardIsDown(sdl.SCANCODE_RIGHT) {
        val rot = -ROT_SPEED * dt
        val old_dir_x = g_dir_x
        g_dir_x = g_dir_x * math.cos(rot) - g_dir_y * math.sin(rot)
        g_dir_y = old_dir_x * math.sin(rot) + g_dir_y * math.cos(rot)
        val old_plane_x = g_plane_x
        g_plane_x = g_plane_x * math.cos(rot) - g_plane_y * math.sin(rot)
        g_plane_y = old_plane_x * math.sin(rot) + g_plane_y * math.cos(rot)
    }

    val move = MOVE_SPEED * dt
    if sdl.KeyboardIsDown(sdl.SCANCODE_W) {
        val nx = g_pos_x + g_dir_x * move
        val ny = g_pos_y + g_dir_y * move
        if !g_map.solid(math.floor(nx) as i32, math.floor(g_pos_y) as i32) {
            g_pos_x = nx
        }
        if !g_map.solid(math.floor(g_pos_x) as i32, math.floor(ny) as i32) {
            g_pos_y = ny
        }
    }
    if sdl.KeyboardIsDown(sdl.SCANCODE_S) {
        val nx = g_pos_x - g_dir_x * move
        val ny = g_pos_y - g_dir_y * move
        if !g_map.solid(math.floor(nx) as i32, math.floor(g_pos_y) as i32) {
            g_pos_x = nx
        }
        if !g_map.solid(math.floor(g_pos_x) as i32, math.floor(ny) as i32) {
            g_pos_y = ny
        }
    }
    if sdl.KeyboardIsDown(sdl.SCANCODE_A) {
        val nx = g_pos_x - g_plane_x * move
        val ny = g_pos_y - g_plane_y * move
        if !g_map.solid(math.floor(nx) as i32, math.floor(g_pos_y) as i32) {
            g_pos_x = nx
        }
        if !g_map.solid(math.floor(g_pos_x) as i32, math.floor(ny) as i32) {
            g_pos_y = ny
        }
    }
    if sdl.KeyboardIsDown(sdl.SCANCODE_D) {
        val nx = g_pos_x + g_plane_x * move
        val ny = g_pos_y + g_plane_y * move
        if !g_map.solid(math.floor(nx) as i32, math.floor(g_pos_y) as i32) {
            g_pos_x = nx
        }
        if !g_map.solid(math.floor(g_pos_x) as i32, math.floor(ny) as i32) {
            g_pos_y = ny
        }
    }

    render_frame(g_pixels, g_map, g_pos_x, g_pos_y, g_dir_x, g_dir_y, g_plane_x, g_plane_y)

    _ = g_tex.update(g_pixels.ptr as *const void)
    _ = g_ren.set_draw_color(0, 0, 0, 255)
    _ = g_ren.clear()
    _ = g_ren.draw_texture(g_tex)
    _ = g_ren.present()
    return 1
}

fn main() {
    with (mem.heap()) {
        var err = sdl.Init(sdl.INIT_VIDEO)
        if err != null {
            panic("SDL Init failed: ${err!!.message()}")
        }

        var (win, ren, create_err) = sdl.CreateWindowAndRenderer(
            "JogSDL raycaster",
            SCREEN_W,
            SCREEN_H,
            sdl.WINDOW_RESIZABLE
        )
        if create_err != null {
            panic("CreateWindowAndRenderer failed: ${create_err!!.message()}")
        }
        g_win = win
        g_ren = ren

        var (tex, tex_err) = g_ren.create_streaming_texture(SCREEN_W, SCREEN_H)
        if tex_err != null {
            panic("CreateTexture failed: ${tex_err!!.message()}")
        }
        g_tex = tex

        g_pixels = mem.newSlice<u32>((SCREEN_W * SCREEN_H) as usize)
        g_map = demo_map()
        g_last_ticks = sdl.GetTicks()
        g_running = true

        // Desktop: while-iterate. Emscripten: requestAnimationFrame via emcc.
        jog_host_run_loop(tick_frame)

        mem.freeSlice(g_pixels)
        g_tex.destroy()
        g_ren.destroy()
        g_win.destroy()
        sdl.Quit()
    }
}

fn render_frame(
    pixels: []u32,
    map: Map,
    pos_x: f64,
    pos_y: f64,
    dir_x: f64,
    dir_y: f64,
    plane_x: f64,
    plane_y: f64
) {
    val w = SCREEN_W
    val h = SCREEN_H
    var x: i32 = 0
    for x < w {
        val camera_x = 2.0 * (x as f64) / (w as f64) - 1.0
        val ray_dir_x = dir_x + plane_x * camera_x
        val ray_dir_y = dir_y + plane_y * camera_x
        val hit = map.cast(pos_x, pos_y, ray_dir_x, ray_dir_y)
        var line_h = ((h as f64) / hit.dist) as i32
        if line_h > h * 4 {
            line_h = h * 4
        }
        var draw_start = -line_h / 2 + h / 2
        var draw_end = line_h / 2 + h / 2
        if draw_start < 0 {
            draw_start = 0
        }
        if draw_end >= h {
            draw_end = h - 1
        }
        val color = wall_color(hit.wall_id, hit.side)

        var y: i32 = 0
        for y < h {
            val idx = (y * w + x) as usize
            if y < draw_start {
                pixels[idx] = CEILING_COLOR
            } else if y > draw_end {
                pixels[idx] = FLOOR_COLOR
            } else {
                pixels[idx] = color
            }
            y = y + 1
        }
        x = x + 1
    }
}
