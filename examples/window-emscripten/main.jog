// Emscripten window smoke (JOG-90). Must return each frame via
// jog_host_run_loop(tick); a blocking while does not present under emcc.
// Auto-exits after LIMIT_MS so headless/browser smoke can finish.
// Stashes opaque pointers via raw_ptr() (Friction: no handle globals in tick).

val LIMIT_MS: u64 = 1500

var g_win_ptr: *byte = null
var g_ren_ptr: *byte = null
var g_running: i64 = 0
var g_start: u64 = 0
var g_evbuf: *byte = null

@export
fn tick(): i32 {
    var ev = EventBuf(ptr: g_evbuf)
    while (ev.poll() != 0) {
        val kind = ev.kind()
        if (kind == EventTypeId.Quit || kind == EventTypeId.WindowCloseRequested) {
            g_running = 0
        }
        if (kind == EventTypeId.KeyDown) {
            if (ev.scancode() == Scancode.Escape) {
                g_running = 0
            }
        }
    }
    if (g_running == 0) {
        return 0
    }
    if (GetTicks() - g_start >= LIMIT_MS) {
        return 0
    }

    var ren = Renderer(ptr: g_ren_ptr)
    ren.set_draw_color(12, 48, 64, 255)
    ren.clear()
    ren.set_draw_color(80, 200, 180, 255)
    var rect = frect(220.0 as f32, 160.0 as f32, 200.0 as f32, 160.0 as f32)
    ren.fill_rect(&rect)
    ren.present()
    Delay(16)
    return 1
}

fn main() {
    if Init(InitFlag.Video) != null {
        panic("SDL Init failed\n")
    }

    val (win, win_err) = CreateWindow(c"JogSDL v2 wasm", 640, 480, WindowFlag.Resizable)
    if (win_err != null || win.ok() == 0) {
        panic("SDL CreateWindow failed\n")
    }
    g_win_ptr = win.raw_ptr()

    val (ren, ren_err) = win.create_renderer()
    if (ren_err != null || ren.ok() == 0) {
        panic("SDL CreateRenderer failed\n")
    }
    g_ren_ptr = ren.raw_ptr()

    g_evbuf = make_event_buf().raw_ptr()
    g_start = GetTicks()
    g_running = 1

    jog_host_run_loop(tick)

    // Reached after emscripten_cancel_main_loop (or native while exit).
    ren.destroy()
    win.destroy()
    Quit()
    print("window emscripten exit\n")
}
